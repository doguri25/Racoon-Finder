// The colors, fonts and sizes of the screens: the tokens of the theme shown, which Rust gives
// each window from the theme's token file (`theme::Tokens`, crates/rf-ui/themes/*.toml;
// docs/ux/themes.md says what each means). No other .slint file writes a font size or a color
// of its own (a test reads them all).
//
// The values here are the light theme's, which a window shows until Rust gives it its theme
// (a test keeps them equal to crates/rf-ui/themes/light.toml). A window asks for the tokens of
// its theme with `pick`: as it starts, when its `theme-choice`, its `density` or its
// `font-scale` changes, and when the system's own colors turn light or dark. The density and
// the size of text are Rust's to apply (`theme::scaled`): the values here are the theme's at
// 보통 and 100 %.

export global Theme {
    // The theme's `scheme`: the system's own widgets (scroll bars, menus, fields) are drawn
    // dark under it.
    in property <bool> dark: false;
    // What the colors tell is also told by a shape (`marks`, the high contrast theme's): a bar
    // beside a selected item (`SelectedMark`), a badge on a cut or hidden item's icon
    // (`StateBadge`), a dashed frame around a control that cannot be used now (`DashedFrame`), a
    // heavier frame around the chosen one of a set, a frame around a dialog.
    in property <bool> marks: false;
    // How much heavier than the mockup's 1.8 px the icons' lines are (`icon-style`).
    in property <float> icon-weight: 1;
    // How strong a cut item and a hidden item show (their opacity).
    in property <float> dim-cut: 0.4;
    in property <float> dim-hidden: 0.5;

    in property <color> bg: #F6F7F9;
    in property <color> panel: #FFFFFF;
    in property <color> raised: #F0F2F5;
    in property <color> text: #1C2024;
    in property <color> muted: #5C6370;
    // Hints and placeholders, and what is dimmed in a tree.
    in property <color> faint: #8A919C;
    // The text and icons of a control that cannot be used now.
    in property <color> disabled: #8A919C;
    in property <color> border: #E1E4E8;
    // Under a pressed button, an open menu's button, a hovered tab or segment.
    in property <color> pressed: #E1E4E8;
    in property <color> folder: #B7791F;
    // What warns (an overwrite): for icons only; a warning's text stays `text`.
    in property <color> warning: #B7791F;
    in property <color> accent: #2F6FEB;
    in property <color> on-accent: #FFFFFF;
    in property <color> selection: #E6EEFD;
    // Behind the selected text in a field, and that text.
    in property <color> text-selection: #E6EEFD;
    in property <color> on-text-selection: #1C2024;
    in property <color> toast-bg: #1C2024;
    in property <color> toast-text: #F2F4F7;
    in property <color> toast-link: #9DBBFF;
    // Over a notice's button the pointer is over, and one pressed.
    in property <color> toast-hover: #FFFFFF1F;
    in property <color> toast-pressed: #FFFFFF33;
    // The shadows: of menus, the pointer's hints and the long press's ring; of the chosen part
    // of a segmented choice; of a notice; of a dialog.
    in property <color> shadow: #00000033;
    in property <color> shadow-small: #00000029;
    in property <color> shadow-toast: #0000003D;
    in property <color> shadow-dialog: #00000052;
    // Over the window behind a dialog or quick look, and over the picker under a dialog.
    in property <color> scrim: #00000059;
    in property <color> scrim-light: #00000033;

    // The font families (empty: the system's): of the window, of the lists of items, and the
    // fixed width one (empty: each system's own, `PreviewFont`).
    in property <string> font-ui: "";
    in property <string> font-list: "";
    in property <string> font-mono: "";

    in property <length> font-small: 12px;
    // Notes and hints beside the main text of a dialog.
    in property <length> font-note: 13px;
    in property <length> font-body: 14px;
    // The app's name in the toolbar.
    in property <length> font-app-name: 15px;
    // The heading of a notice, of a preview and of a folder that cannot open.
    in property <length> font-heading: 16px;
    in property <length> font-title: 20px;

    in property <length> gap-xs: 4px;
    in property <length> gap-s: 8px;
    in property <length> gap-m: 12px;
    in property <length> gap-l: 16px;

    in property <length> row-height: 32px;
    in property <length> radius: 8px;
    // Panes and the sidebar.
    in property <length> radius-large: 12px;

    // A window asks Rust for the tokens of the theme `choice` (its `theme-choice`), with
    // whether the system's own widgets are dark now (`system-dark`, which 시스템 설정 따르기
    // follows), at its `density` (0 촘촘하게, 1 보통, 2 넉넉하게) and its size of text
    // (`font-scale`, in percent: 90, 100, 115 or 130; THEME-07). Rust gives them to that window's
    // `Theme` before this returns, the row height, the gaps and the font sizes scaled.
    callback pick(choice: int, system-dark: bool, density: int, font-scale: int);

    // The room of a line of text of `size`: 1.5 times it, in whole pixels up. The fonts of the
    // systems draw a line 1.2 to 1.45 times their size; a height that holds text grows with it
    // where the text would not fit (the same share as Rust's `theme::line`, which a test holds
    // to this).
    public pure function line(size: length) -> length {
        return ceil(size * 1.5 / 1px) * 1px;
    }
}

// What marks a selected item besides its color while the theme has `marks`: a short bar at
// its start, or one along its foot (`foot`, the icon views' items). It fills the item; the item
// shows it only then (`if Theme.marks && …`).
export component SelectedMark inherits Rectangle {
    in property <bool> foot;

    Rectangle {
        x: root.foot ? 8px : 4px;
        y: root.foot ? root.height - 6px : (root.height - self.height) / 2;
        width: root.foot ? max(0px, root.width - 16px) : 3px;
        height: root.foot ? 3px : max(8px, root.height - 12px);
        border-radius: 1.5px;
        background: Theme.accent;
    }
}

// A frame of short dashes around a control that cannot be used now, while the theme has `marks`:
// its dimmer color is not all that tells it. It fills the control; the control shows it only
// then (`if Theme.marks && !root.enabled: …`).
export component DashedFrame inherits Rectangle {
    // The dashes' color.
    in property <brush> line: Theme.disabled;
    private property <length> dash: 3px;
    private property <length> step: 6px;
    private property <int> across: max(1, floor((root.width - root.dash) / root.step) + 1);
    private property <int> down: max(1, floor((root.height - root.dash) / root.step) + 1);

    for i in root.across: Rectangle {
        x: i * root.step;
        y: 0px;
        width: root.dash;
        height: 1px;
        background: root.line;
    }
    for i in root.across: Rectangle {
        x: i * root.step;
        y: root.height - 1px;
        width: root.dash;
        height: 1px;
        background: root.line;
    }
    for i in root.down: Rectangle {
        x: 0px;
        y: i * root.step;
        width: 1px;
        height: root.dash;
        background: root.line;
    }
    for i in root.down: Rectangle {
        x: root.width - 1px;
        y: i * root.step;
        width: 1px;
        height: root.dash;
        background: root.line;
    }
}
