// The column heads and the rows of a folder listing. The rows are a virtualized ListView:
// only the rows on screen exist as elements, so a folder of 100,000 items scrolls as freely
// as one of ten. A right click opens the menu of the row (move and copy first, OPS-05), or of
// the empty part of the list; each item says the key of its command (KEY-03).
//
// A row can be dragged (DND): its payload is what Rust readied when the row was pressed
// (`drag-data`, the id of the items it noted). The whole list is one place to drop on, which
// asks Rust about the row under the pointer: a folder's row takes the items into that folder,
// any other row and the part below the rows into the pane's folder. A place that takes them
// shows an accent frame, and what the drop would do; one that does not shows nothing, and the
// pointer says so.

import { ListView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Icon } from "icons.slint";
import { Shortcuts } from "shortcuts.slint";

// One row of the list, as Rust formats it.
export struct FileRow {
    name: string,
    size: string,
    modified: string,
    kind: string,
    is-dir: bool,
    is-link: bool,
    selected: bool,
    hidden: bool,
}

// A column head: its name, and an arrow on the column the list is sorted by.
component HeadCell inherits Rectangle {
    in property <string> text;
    in property <bool> sorted;
    in property <bool> ascending;
    in property <bool> align-end;
    callback clicked();

    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => {
        root.clicked();
    }

    HorizontalLayout {
        alignment: root.align-end ? end : start;
        spacing: 2px;

        Text {
            accessible-role: none;
            text: root.text;
            font-size: Theme.font-small;
            font-weight: 500;
            color: touch.has-hover ? Theme.text : Theme.muted;
            vertical-alignment: center;
            overflow: elide;
        }
        if root.sorted: Icon {
            y: (parent.height - self.height) / 2;
            width: 14px;
            height: 14px;
            name: root.ascending ? "sort-up" : "sort-down";
            color: Theme.muted;
        }
    }

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

export component FileList inherits Rectangle {
    in property <[FileRow]> rows;
    // The keyboard cursor's row, or -1.
    in property <int> cursor: -1;
    // The column the rows are sorted by: 0 name, 1 size, 2 modified, 3 kind.
    in property <int> sort-key;
    in property <bool> sort-ascending: true;
    // Whether this list's pane has the keyboard; the cursor frame shows only then.
    in property <bool> active;
    // How many whole rows fit on screen, for PageUp and PageDown.
    out property <int> page-rows: max(1, floor(list.visible-height / Theme.row-height));
    // The payload of a drag of the rows: the id of the items the last press readied.
    in property <data-transfer> drag-data;
    // What a drop here would do ("항목 3개 이동 → 백업"), as Rust last said while the drag
    // hovered; shown while this list takes the drag.
    in property <string> drag-label;
    // Why the place under the pointer does not take the drag ("여기에 놓을 수 없습니다: …"), while
    // a drag hovers there; empty otherwise.
    in property <string> refusal;

    callback sort(column: int);
    // A left press on row `index`, and its release when no drag came of it (a click).
    callback row-clicked(index: int, ctrl: bool, shift: bool);
    callback row-released(index: int);
    callback row-activated(index: int);
    // A right click on row `index`, just before its menu opens.
    callback row-menu(index: int);
    // A menu item: the name of the toolbar command it runs (move, copy, open, rename, delete,
    // delete-permanently, new-folder).
    callback menu-command(name: string);
    // A drag with the payload `data` is over row `index` (-1 below the rows) and asks for
    // `action`: the action this list takes, or `none`. Then the drop itself, the same way.
    callback drop-check(data: data-transfer, index: int, action: DragAction) -> DragAction;
    callback dropped(data: data-transfer, index: int, action: DragAction) -> DragAction;
    // A drag of this list's rows ended, dropped or not.
    callback drag-ended();

    // Scrolls as little as needed to show row `index` whole.
    //
    // After a jump of more than a screen and a half (End in a long folder), the list makes the
    // rows of the new place afresh and lines the first of them up with the top of the list, which
    // rounds the place up by part of a row: the last row would stay cut. So while the list
    // settles (`settling`), a place it moves to by itself is set back to the one asked for, once;
    // a scroll of the user's ends that.
    public function scroll-to(index: int) {
        if (index < 0) {
            return;
        }
        let top = index * Theme.row-height;
        if (top + list.content-y < 0) {
            root.scroll-target = -top;
        } else if (top + Theme.row-height + list.content-y > list.visible-height) {
            root.scroll-target = list.visible-height - top - Theme.row-height;
        } else {
            return;
        }
        root.settling = true;
        list.content-y = root.scroll-target;
        settle.restart();
    }

    private property <length> scroll-target;
    private property <bool> settling;

    settle := Timer {
        interval: 500ms;
        running: false;
        triggered => {
            self.stop();
            root.settling = false;
        }
    }

    // The row at `y` in the list (the rows are all `Theme.row-height` tall), or -1 below them.
    function row-at(y: length) -> int {
        let row = floor((y - list.content-y) / Theme.row-height);
        return row >= 0 && row < root.rows.length ? row : -1;
    }

    // Column geometry, shared by the heads and the rows. The columns are placed by hand, not
    // by a layout, so that which ones show can follow the width without a binding loop. As the
    // list narrows, the kind goes first, then the date, then the size.
    private property <length> pad: 12px;
    private property <length> gap: 10px;
    private property <length> icon-room: 26px;
    // All four columns fit a pane of the default 1280px window (about 494px wide); the date
    // column holds the widest `2026-10-28 22:08`.
    private property <length> name-min: 120px;
    private property <length> size-w: 72px;
    private property <length> date-w: 126px;
    private property <length> kind-w: 104px;
    private property <bool> show-kind: root.width >= 2 * root.pad + root.name-min + 3 * root.gap + root.size-w + root.date-w + root.kind-w;
    private property <bool> show-date: root.width >= 2 * root.pad + root.name-min + 2 * root.gap + root.size-w + root.date-w;
    private property <bool> show-size: root.width >= 2 * root.pad + root.name-min + root.gap + root.size-w;
    private property <length> kind-x: root.width - root.pad - root.kind-w;
    private property <length> date-x: (root.show-kind ? root.kind-x - root.gap : root.width - root.pad) - root.date-w;
    private property <length> size-x: (root.show-date ? root.date-x - root.gap : root.show-kind ? root.kind-x - root.gap : root.width - root.pad) - root.size-w;
    private property <length> name-end: root.show-size ? root.size-x - root.gap : root.width - root.pad;

    VerticalLayout {
        Rectangle {
            height: 32px;

            HeadCell {
                x: root.pad;
                width: root.name-end - root.pad;
                text: "이름";
                sorted: root.sort-key == 0;
                ascending: root.sort-ascending;
                clicked => {
                    root.sort(0);
                }
            }
            if root.show-size: HeadCell {
                x: root.size-x;
                width: root.size-w;
                text: "크기";
                align-end: true;
                sorted: root.sort-key == 1;
                ascending: root.sort-ascending;
                clicked => {
                    root.sort(1);
                }
            }
            if root.show-date: HeadCell {
                x: root.date-x;
                width: root.date-w;
                text: "수정한 날짜";
                sorted: root.sort-key == 2;
                ascending: root.sort-ascending;
                clicked => {
                    root.sort(2);
                }
            }
            if root.show-kind: HeadCell {
                x: root.kind-x;
                width: root.kind-w;
                text: "종류";
                sorted: root.sort-key == 3;
                ascending: root.sort-ascending;
                clicked => {
                    root.sort(3);
                }
            }

            Rectangle {
                y: parent.height - self.height;
                height: 1px;
                background: Theme.border;
            }
        }

        Rectangle {
            vertical-stretch: 1;

            drop := DropArea {
                // The folder row the drag would go into; -1 for the pane's folder.
                property <int> target-row: -1;
                can-drop(event) => {
                    let row = root.row-at(event.position.y);
                    self.target-row = row >= 0 && root.rows[row].is-dir ? row : -1;
                    return root.drop-check(event.data, row, event.proposed-action);
                }
                dropped(event) => {
                    return root.dropped(event.data, root.row-at(event.position.y), event.proposed-action);
                }

                // The menu of the part of the list below the rows.
                ContextMenuArea {
                    width: parent.width;
                    height: parent.height;

                    Menu {
                        MenuItem {
                            title: Shortcuts.titled("새 폴더", Shortcuts.new-folder);
                            activated => {
                                root.menu-command("new-folder");
                            }
                        }
                    }

                    list := ListView {
                        width: parent.width;
                        height: parent.height;
                        accessible-label: "항목 목록";
                        changed content-y => {
                            if (root.settling && self.content-y != root.scroll-target) {
                                root.settling = false;
                                self.content-y = root.scroll-target;
                            }
                        }
                        scrolled => {
                            root.settling = false;
                        }

                        for row[i] in root.rows: Rectangle {
                            height: Theme.row-height;
                            background: row.selected ? Theme.selection : touch.has-hover ? Theme.raised : transparent;
                            accessible-role: list-item;
                            accessible-label: row.name;
                            accessible-item-index: i;
                            accessible-item-selectable: true;
                            accessible-item-selected: row.selected;
                            accessible-action-default => {
                                root.row-activated(i);
                            }

                            // A press readies a drag of what it selects, or keeps selected.
                            DragArea {
                                data: root.drag-data;
                                allow-move: true;
                                allow-copy: true;
                                drag-finished(action) => {
                                    root.drag-ended();
                                }

                                row-menu := ContextMenuArea {
                                    Menu {
                                        MenuItem {
                                            title: Shortcuts.titled("이동…", Shortcuts.move-to);
                                            activated => {
                                                root.menu-command("move");
                                            }
                                        }
                                        MenuItem {
                                            title: Shortcuts.titled("복사…", Shortcuts.copy-to);
                                            activated => {
                                                root.menu-command("copy");
                                            }
                                        }
                                        MenuSeparator { }
                                        MenuItem {
                                            title: Shortcuts.titled("열기", Shortcuts.open);
                                            activated => {
                                                root.menu-command("open");
                                            }
                                        }
                                        MenuItem {
                                            title: Shortcuts.titled("이름 바꾸기", Shortcuts.rename);
                                            activated => {
                                                root.menu-command("rename");
                                            }
                                        }
                                        MenuSeparator { }
                                        MenuItem {
                                            title: Shortcuts.titled("휴지통으로 보내기", Shortcuts.trash);
                                            activated => {
                                                root.menu-command("delete");
                                            }
                                        }
                                        MenuItem {
                                            title: Shortcuts.titled("영구 삭제", Shortcuts.delete-permanently);
                                            activated => {
                                                root.menu-command("delete-permanently");
                                            }
                                        }
                                    }

                                    // It takes the right click itself, so the row is selected before its
                                    // menu opens.
                                    touch := TouchArea {
                                        pointer-event(event) => {
                                            if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                                                root.row-clicked(i, event.modifiers.control, event.modifiers.shift);
                                            }
                                            if (event.kind == PointerEventKind.down && event.button == PointerEventButton.right) {
                                                root.row-menu(i);
                                                row-menu.show({ x: self.mouse-x, y: self.mouse-y });
                                            }
                                        }
                                        // Not after a drag: the drag takes the pointer from the row.
                                        clicked => {
                                            root.row-released(i);
                                        }
                                        double-clicked => {
                                            root.row-activated(i);
                                        }
                                    }
                                }
                            }

                            // Hidden items show at half strength.
                            Rectangle {
                                opacity: row.hidden ? 0.5 : 1;

                                Icon {
                                    x: root.pad;
                                    y: (parent.height - self.height) / 2;
                                    width: 18px;
                                    height: 18px;
                                    name: row.is-link ? "link" : row.is-dir ? "folder" : "file";
                                    color: row.is-dir ? Theme.folder : Theme.muted;
                                }
                                Text {
                                    x: root.pad + root.icon-room;
                                    width: root.name-end - self.x;
                                    height: parent.height;
                                    text: row.name;
                                    color: Theme.text;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                                if root.show-size: Text {
                                    x: root.size-x;
                                    width: root.size-w;
                                    height: parent.height;
                                    text: row.size;
                                    color: Theme.muted;
                                    horizontal-alignment: right;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                                if root.show-date: Text {
                                    x: root.date-x;
                                    width: root.date-w;
                                    height: parent.height;
                                    text: row.modified;
                                    color: Theme.muted;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                                if root.show-kind: Text {
                                    x: root.kind-x;
                                    width: root.kind-w;
                                    height: parent.height;
                                    text: row.kind;
                                    color: Theme.muted;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                            }

                            if root.active && i == root.cursor: Rectangle {
                                x: 2px;
                                width: parent.width - 4px;
                                border-width: 1px;
                                border-color: Theme.accent;
                                border-radius: 4px;
                            }
                            // The folder a drag over this row would go into.
                            if drop.has-drag && i == drop.target-row: Rectangle {
                                x: 2px;
                                width: parent.width - 4px;
                                border-width: 2px;
                                border-color: Theme.accent;
                                border-radius: 4px;
                            }
                        }
                    }
                }
            }

            // The pane's folder takes the drag: a frame around the list.
            if drop.has-drag && drop.target-row < 0: Rectangle {
                x: 2px;
                y: 2px;
                width: parent.width - 4px;
                height: parent.height - 4px;
                border-width: 2px;
                border-color: Theme.accent;
                border-radius: Theme.radius;
            }
            // Why the drag cannot go where the pointer is.
            if !drop.has-drag && root.refusal != "": Rectangle {
                x: (parent.width - self.width) / 2;
                y: parent.height - self.height - 14px;
                width: min(refused.preferred-width + 28px, parent.width - 24px);
                height: 30px;
                border-radius: 15px;
                background: Theme.toast-bg;

                refused := Text {
                    width: parent.width - 28px;
                    text: root.refusal;
                    color: Theme.toast-text;
                    font-weight: 600;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
            // What the drop would do.
            if drop.has-drag && root.drag-label != "": Rectangle {
                x: (parent.width - self.width) / 2;
                y: parent.height - self.height - 14px;
                width: min(label.preferred-width + 28px, parent.width - 24px);
                height: 30px;
                border-radius: 15px;
                background: Theme.accent;

                label := Text {
                    width: parent.width - 28px;
                    text: root.drag-label;
                    color: Theme.on-accent;
                    font-weight: 600;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }
    }
}
