// The column heads and the rows of a folder listing in 자세히 (the other views are in
// `file-grid.slint`). The rows are a virtualized ListView: only the rows on screen exist as
// elements, so a folder of 100,000 items scrolls as freely as one of ten. A right click opens
// the menu of the row (move and copy first, OPS-05), or of the empty part of the list; each item
// says the key of its command (KEY-03).
//
// The columns (NAV-07): the name, always first, takes the room the others leave; the others
// follow in the order Rust gives (`columns`), as wide as Rust says, and when the list is too
// narrow for them all the last ones go first. A head's right click opens the menu that shows or
// hides the columns; a head dragged sideways moves its column among the others (a drag of the
// pointer, not a drag of items: it carries no payload and nothing drops it); the border before a
// column, dragged, trades width between that column and the one before it (the name takes what
// the first column gives up), and double-clicked, fits the column to the rows on screen. A click
// on a head sorts by its column, with Shift by a second key.
//
// A row can be dragged (DND): its payload is what Rust readied when the row was pressed
// (`drag-data`, the id of the items it noted). The whole list is one place to drop on, which
// asks Rust about the row under the pointer: a folder's row takes the items into that folder,
// any other row and the part below the rows into the pane's folder. A place that takes them
// shows an accent frame, and what the drop would do; one that does not shows nothing, and the
// pointer says so.

import { ListView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Icon } from "icons.slint";
import { Shortcuts } from "shortcuts.slint";

// One row of the list, as Rust formats it: the texts of every column, the line icon of the
// other views, and how it shows.
export struct FileRow {
    name: string,
    size: string,
    modified: string,
    created: string,
    kind: string,
    extension: string,
    attributes: string,
    // The line icon of the icon views and 목록 (`Icon.name`).
    icon: string,
    is-dir: bool,
    is-link: bool,
    selected: bool,
    hidden: bool,
}

// A column after the name, as Rust says: its number (1 size, 2 modified, 3 kind, 4 created,
// 5 extension, 6 attributes), what its head says, how wide it is, whether its text lines up on
// the right, and whether a click on its head sorts.
export struct ColumnView {
    id: int,
    title: string,
    width: length,
    align-end: bool,
    sortable: bool,
}

// The text of the column numbered `id` of `row`.
export global Cells {
    public pure function text(row: FileRow, id: int) -> string {
        if (id == 1) {
            return row.size;
        }
        if (id == 2) {
            return row.modified;
        }
        if (id == 3) {
            return row.kind;
        }
        if (id == 4) {
            return row.created;
        }
        if (id == 5) {
            return row.extension;
        }
        if (id == 6) {
            return row.attributes;
        }
        return row.name;
    }
}

// A column head: its name, an arrow on the column the rows are sorted by first (a fainter one
// on the column of the second key). A left click is `clicked`, with Shift or not; a left press
// moved sideways is a drag of the head along the header (`movable`), told where the pointer is
// (`dragging`, relative to the head) and where it was let go (`dropped`); a right click asks
// for the header's menu at a point of the head.
component HeadCell inherits Rectangle {
    in property <string> text;
    // 0 the rows are not sorted by this column, 1 they are first, 2 second.
    in property <int> sorted;
    in property <bool> ascending;
    in property <bool> align-end;
    in property <bool> movable;
    callback clicked(shift: bool);
    callback dragging(at: length);
    callback dropped(at: length);
    callback menu(x: length, y: length);

    private property <bool> moving;

    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => {
        root.clicked(false);
    }

    HorizontalLayout {
        alignment: root.align-end ? end : start;
        spacing: 2px;

        Text {
            accessible-role: none;
            text: root.text;
            font-size: Theme.font-small;
            font-weight: 500;
            color: touch.has-hover || root.moving ? Theme.text : Theme.muted;
            vertical-alignment: center;
            overflow: elide;
        }
        if root.sorted > 0: Icon {
            y: (parent.height - self.height) / 2;
            width: 14px;
            height: 14px;
            name: root.ascending ? "sort-up" : "sort-down";
            color: root.sorted == 1 ? Theme.muted : Theme.faint;
        }
    }

    touch := TouchArea {
        pointer-event(event) => {
            if (event.button == PointerEventButton.right && event.kind == PointerEventKind.down) {
                root.menu(self.mouse-x, self.mouse-y);
                return;
            }
            if (event.button != PointerEventButton.left) {
                return;
            }
            if (event.kind == PointerEventKind.down) {
                root.moving = false;
            } else if (event.kind == PointerEventKind.up) {
                if (root.moving) {
                    root.moving = false;
                    root.dropped(self.mouse-x);
                } else if (self.has-hover) {
                    root.clicked(event.modifiers.shift);
                }
            } else if (event.kind == PointerEventKind.cancel && root.moving) {
                root.moving = false;
                root.dropped(-1000000px);
            }
        }
        moved => {
            if (root.movable && self.pressed && abs(self.mouse-x - self.pressed-x) > 6px) {
                root.moving = true;
            }
            if (root.moving) {
                root.dragging(self.mouse-x);
            }
        }
    }
}

export component FileList inherits Rectangle {
    in property <[FileRow]> rows;
    // The keyboard cursor's row, or -1.
    in property <int> cursor: -1;
    // The columns after the name, in their order, and which columns show by number (0 to 6),
    // for the head's menu.
    in property <[ColumnView]> columns;
    in property <[bool]> shows;
    // The column the rows are sorted by first (0 name, then as `ColumnView.id`), and the one of
    // the second key (-1 for none).
    in property <int> sort-key;
    in property <bool> sort-ascending: true;
    in property <int> then-key: -1;
    in property <bool> then-ascending: true;
    // Whether this list's pane has the keyboard; the cursor frame shows only then.
    in property <bool> active;
    // How many whole rows fit on screen, for PageUp and PageDown, and the first row on screen.
    out property <int> page-rows: max(1, floor(list.visible-height / Theme.row-height));
    out property <int> first-row: max(0, floor(-list.content-y / Theme.row-height));
    // The payload of a drag of the rows: the id of the items the last press readied.
    in property <data-transfer> drag-data;
    // What a drop here would do ("항목 3개 이동 → 백업"), as Rust last said while the drag
    // hovered; shown while this list takes the drag.
    in property <string> drag-label;
    // Why the place under the pointer does not take the drag ("여기에 놓을 수 없습니다: …"), while
    // a drag hovers there; empty otherwise.
    in property <string> refusal;

    // A click on the head of column `column` (with Shift: `then`).
    callback sort(column: int, then: bool);
    // The head's menu showed or hid the column numbered `column`.
    callback column-toggled(column: int);
    // The column at `from` among those after the name was dragged to `slot` (0 before the
    // first of them, their number after the last).
    callback column-moved(from: int, slot: int);
    // The column numbered `column` is to be `width` wide.
    callback column-resized(column: int, width: length);
    // The texts of the column numbered `column` in `count` rows from row `first` on, one a
    // line, for a fit to measure.
    callback column-texts(column: int, first: int, count: int) -> string;
    // A left press on row `index`, and its release when no drag came of it (a click).
    callback row-clicked(index: int, ctrl: bool, shift: bool);
    callback row-released(index: int);
    callback row-activated(index: int);
    // A right click on row `index`, just before its menu opens.
    callback row-menu(index: int);
    // A menu item: the name of the toolbar command it runs (move, copy, open, rename, delete,
    // delete-permanently, new-folder).
    callback menu-command(name: string);
    // A drag with the payload `data` is over row `index` (-1 below the rows) and asks for
    // `action`: the action this list takes, or `none`. Then the drop itself, the same way.
    callback drop-check(data: data-transfer, index: int, action: DragAction) -> DragAction;
    callback dropped(data: data-transfer, index: int, action: DragAction) -> DragAction;
    // A drag of this list's rows ended.
    callback drag-ended();

    // Scrolls as little as needed to show row `index` whole.
    //
    // After a jump of more than a screen and a half (End in a long folder), the list makes the
    // rows of the new place afresh and lines the first of them up with the top of the list, which
    // rounds the place up by part of a row: the last row would stay cut. So while the list
    // settles (`settling`), a place it moves to by itself is set back to the one asked for, once;
    // a scroll of the user's ends that.
    public function scroll-to(index: int) {
        if (index < 0) {
            return;
        }
        let top = index * Theme.row-height;
        if (top + list.content-y < 0) {
            root.scroll-target = -top;
        } else if (top + Theme.row-height + list.content-y > list.visible-height) {
            root.scroll-target = list.visible-height - top - Theme.row-height;
        } else {
            return;
        }
        root.settling = true;
        list.content-y = root.scroll-target;
        settle.restart();
    }

    private property <length> scroll-target;
    private property <bool> settling;

    settle := Timer {
        interval: 500ms;
        running: false;
        triggered => {
            self.stop();
            root.settling = false;
        }
    }

    // The row at `y` in the list (the rows are all `Theme.row-height` tall), or -1 below them.
    function row-at(y: length) -> int {
        let row = floor((y - list.content-y) / Theme.row-height);
        return row >= 0 && row < root.rows.length ? row : -1;
    }

    // Column geometry, shared by the heads and the rows. The columns are placed by hand, not
    // by a layout, so that which ones show can follow the width without a binding loop.
    private property <length> pad: 12px;
    private property <length> gap: 10px;
    private property <length> icon-room: 26px;
    private property <length> name-min: 120px;
    // The border before column `drag-border` is being dragged, `drag-dx` from where it was.
    private property <int> drag-border: -1;
    private property <length> drag-dx;
    // The head of column `head-drag` is being dragged; the pointer is at `head-pointer` of the
    // header.
    private property <int> head-drag: -1;
    private property <length> head-pointer;

    // How wide column `i` after the name is now, a border drag counted in: the column after the
    // border gives up what the one before it takes.
    pure function w(i: int) -> length {
        if (i < 0 || i >= root.columns.length) {
            return 0px;
        }
        let base = root.columns[i].width;
        if (i == root.drag-border) {
            return base - root.drag-dx;
        }
        if (i + 1 == root.drag-border) {
            return base + root.drag-dx;
        }
        return base;
    }
    // The room the first `k` columns after the name take, each with the gap before it.
    pure function s(k: int) -> length {
        return (k > 0 ? root.gap + root.w(0) : 0px) + (k > 1 ? root.gap + root.w(1) : 0px) + (k > 2 ? root.gap + root.w(2) : 0px) + (k > 3 ? root.gap + root.w(3) : 0px) + (k > 4 ? root.gap + root.w(4) : 0px) + (k > 5 ? root.gap + root.w(5) : 0px);
    }
    pure function fits(k: int) -> bool {
        return k <= root.columns.length && 2 * root.pad + root.name-min + root.s(k) <= root.width;
    }
    // How many columns after the name show: as many as leave the name its least room.
    private property <int> shown: root.fits(6) ? 6 : root.fits(5) ? 5 : root.fits(4) ? 4 : root.fits(3) ? 3 : root.fits(2) ? 2 : root.fits(1) ? 1 : 0;
    private property <length> shown-room: root.s(root.shown);
    private property <length> name-end: root.width - root.pad - root.shown-room;
    // Where column `i` after the name starts.
    pure function col-x(i: int) -> length {
        return root.name-end + root.s(i) + root.gap;
    }
    // The place among the columns after the name that a head let go at `at` of the header goes
    // to: before the first column whose middle is right of it.
    pure function slot-at(at: length) -> int {
        return (root.shown > 0 && root.col-x(0) + root.w(0) / 2 < at ? 1 : 0) + (root.shown > 1 && root.col-x(1) + root.w(1) / 2 < at ? 1 : 0) + (root.shown > 2 && root.col-x(2) + root.w(2) / 2 < at ? 1 : 0) + (root.shown > 3 && root.col-x(3) + root.w(3) / 2 < at ? 1 : 0) + (root.shown > 4 && root.col-x(4) + root.w(4) / 2 < at ? 1 : 0) + (root.shown > 5 && root.col-x(5) + root.w(5) / 2 < at ? 1 : 0);
    }
    // Where the line that shows that place is.
    pure function slot-x(slot: int) -> length {
        return slot < root.shown ? root.col-x(slot) - root.gap / 2 : root.col-x(root.shown - 1) + root.w(root.shown - 1) + root.gap / 2;
    }

    // How far the border before column `i` may be dragged: neither column past its least or
    // most width, and the name, beside the first, not below its least.
    pure function clamp-dx(i: int, dx: length) -> length {
        let width = root.columns[i].width;
        let before = i > 0 ? root.columns[i - 1].width : 0px;
        let low = max(width - 600px, i > 0 ? 40px - before : root.name-min + root.pad - (root.name-end - root.drag-dx));
        let high = min(width - 40px, i > 0 ? 600px - before : 100000px);
        return max(low, min(dx, high));
    }

    // The border before column `i` was let go: the two columns it lies between take their new
    // widths (the first column, and the name, which takes the rest).
    function end-resize(i: int, commit: bool) {
        let dx = root.drag-dx;
        let after = root.columns[i];
        let before = root.columns[i - 1];
        root.drag-border = -1;
        root.drag-dx = 0px;
        if (!commit || dx == 0px) {
            return;
        }
        root.column-resized(after.id, after.width - dx);
        if (i > 0) {
            root.column-resized(before.id, before.width + dx);
        }
    }

    // Fits column `i` after the name to its texts in the rows on screen, and to its head.
    function fit(i: int) {
        let column = root.columns[i];
        root.measure-text = root.column-texts(column.id, root.first-row, root.page-rows + 1);
        root.measure-head-text = column.title;
        root.column-resized(column.id, max(measure.preferred-width + 6px, measure-head.preferred-width + 20px));
    }

    private property <string> measure-text;
    private property <string> measure-head-text;
    measure := Text {
        visible: false;
        text: root.measure-text;
        wrap: no-wrap;
    }

    measure-head := Text {
        visible: false;
        text: root.measure-head-text;
        font-size: Theme.font-small;
        font-weight: 500;
    }

    // The check marks of the head's menu, set from `shows` as it opens (a checkable item flips
    // its own mark as it is chosen).
    private property <bool> mark-size;
    private property <bool> mark-modified;
    private property <bool> mark-created;
    private property <bool> mark-kind;
    private property <bool> mark-extension;
    private property <bool> mark-attributes;
    function show-head-menu(x: length, y: length) {
        root.mark-size = root.shows[1];
        root.mark-modified = root.shows[2];
        root.mark-kind = root.shows[3];
        root.mark-created = root.shows[4];
        root.mark-extension = root.shows[5];
        root.mark-attributes = root.shows[6];
        head-menu.show({ x: x, y: y });
    }

    VerticalLayout {
        header := Rectangle {
            height: 32px;

            // The menu of the header (a right click on a head, or between them).
            head-menu := ContextMenuArea {
                width: parent.width;
                height: parent.height;

                Menu {
                    MenuItem {
                        title: "크기";
                        checkable: true;
                        checked <=> root.mark-size;
                        activated => {
                            root.column-toggled(1);
                        }
                    }
                    MenuItem {
                        title: "수정한 날짜";
                        checkable: true;
                        checked <=> root.mark-modified;
                        activated => {
                            root.column-toggled(2);
                        }
                    }
                    MenuItem {
                        title: "만든 날짜";
                        checkable: true;
                        checked <=> root.mark-created;
                        activated => {
                            root.column-toggled(4);
                        }
                    }
                    MenuItem {
                        title: "종류";
                        checkable: true;
                        checked <=> root.mark-kind;
                        activated => {
                            root.column-toggled(3);
                        }
                    }
                    MenuItem {
                        title: "확장자";
                        checkable: true;
                        checked <=> root.mark-extension;
                        activated => {
                            root.column-toggled(5);
                        }
                    }
                    MenuItem {
                        title: "속성";
                        checkable: true;
                        checked <=> root.mark-attributes;
                        activated => {
                            root.column-toggled(6);
                        }
                    }
                }
            }

            HeadCell {
                x: root.pad;
                width: root.name-end - root.pad;
                text: "이름";
                sorted: root.sort-key == 0 ? 1 : root.then-key == 0 ? 2 : 0;
                ascending: root.sort-key == 0 ? root.sort-ascending : root.then-ascending;
                clicked(shift) => {
                    root.sort(0, shift);
                }
                menu(x, y) => {
                    root.show-head-menu(self.x + x, y);
                }
            }
            for column[i] in root.columns: HeadCell {
                x: root.col-x(i);
                width: root.w(i);
                visible: i < root.shown;
                text: column.title;
                align-end: column.align-end;
                movable: true;
                background: root.head-drag == i ? Theme.raised : transparent;
                sorted: !column.sortable ? 0 : column.id == root.sort-key ? 1 : column.id == root.then-key ? 2 : 0;
                ascending: column.id == root.sort-key ? root.sort-ascending : root.then-ascending;
                clicked(shift) => {
                    if (column.sortable) {
                        root.sort(column.id, shift);
                    }
                }
                menu(x, y) => {
                    root.show-head-menu(self.x + x, y);
                }
                dragging(at) => {
                    root.head-drag = i;
                    root.head-pointer = self.x + at;
                }
                dropped(at) => {
                    root.head-drag = -1;
                    if (at > -100000px) {
                        root.column-moved(i, root.slot-at(self.x + at));
                    }
                }
            }

            // The border before each column after the name: dragged, it trades width between the
            // two columns; double-clicked, it fits the column after it.
            for column[i] in root.columns: Rectangle {
                visible: i < root.shown;
                x: root.col-x(i) - root.gap / 2 - 4px;
                width: 8px;
                accessible-role: none;

                grip := TouchArea {
                    mouse-cursor: MouseCursor.col-resize;
                    pointer-event(event) => {
                        if (event.button != PointerEventButton.left) {
                            return;
                        }
                        if (event.kind == PointerEventKind.down) {
                            root.drag-border = i;
                            root.drag-dx = 0px;
                        } else if (event.kind == PointerEventKind.up) {
                            root.end-resize(i, true);
                        } else if (event.kind == PointerEventKind.cancel) {
                            root.end-resize(i, false);
                        }
                    }
                    // The border is where the pointer is, less where it was pressed: it moves
                    // with what it is dragged by, so the move adds to the one so far.
                    moved => {
                        if (self.pressed && root.drag-border == i) {
                            root.drag-dx = root.clamp-dx(i, root.drag-dx + self.mouse-x - self.pressed-x);
                        }
                    }
                    double-clicked => {
                        root.drag-border = -1;
                        root.drag-dx = 0px;
                        root.fit(i);
                    }
                }

                Rectangle {
                    x: (parent.width - self.width) / 2;
                    y: 8px;
                    width: 1px;
                    height: parent.height - 16px;
                    background: grip.has-hover || grip.pressed ? Theme.accent : Theme.border;
                }
            }

            // Where a dragged head would go.
            if root.head-drag >= 0: Rectangle {
                x: root.slot-x(root.slot-at(root.head-pointer)) - 1px;
                y: 4px;
                width: 2px;
                height: parent.height - 8px;
                background: Theme.accent;
            }

            Rectangle {
                y: parent.height - self.height;
                height: 1px;
                background: Theme.border;
            }
        }

        Rectangle {
            vertical-stretch: 1;

            drop := DropArea {
                // The folder row the drag would go into; -1 for the pane's folder.
                property <int> target-row: -1;
                can-drop(event) => {
                    let row = root.row-at(event.position.y);
                    self.target-row = row >= 0 && root.rows[row].is-dir ? row : -1;
                    return root.drop-check(event.data, row, event.proposed-action);
                }
                dropped(event) => {
                    return root.dropped(event.data, root.row-at(event.position.y), event.proposed-action);
                }

                // The menu of the part of the list below the rows.
                ContextMenuArea {
                    width: parent.width;
                    height: parent.height;

                    Menu {
                        MenuItem {
                            title: Shortcuts.titled("새 폴더", Shortcuts.new-folder);
                            activated => {
                                root.menu-command("new-folder");
                            }
                        }
                    }

                    list := ListView {
                        width: parent.width;
                        height: parent.height;
                        accessible-label: "항목 목록";
                        changed content-y => {
                            if (root.settling && self.content-y != root.scroll-target) {
                                root.settling = false;
                                self.content-y = root.scroll-target;
                            }
                        }
                        scrolled => {
                            root.settling = false;
                        }

                        for row[i] in root.rows: Rectangle {
                            height: Theme.row-height;
                            background: row.selected ? Theme.selection : touch.has-hover ? Theme.raised : transparent;
                            accessible-role: list-item;
                            accessible-label: row.name;
                            accessible-item-index: i;
                            accessible-item-selectable: true;
                            accessible-item-selected: row.selected;
                            accessible-action-default => {
                                root.row-activated(i);
                            }

                            // A press readies a drag of what it selects, or keeps selected.
                            DragArea {
                                data: root.drag-data;
                                allow-move: true;
                                allow-copy: true;
                                drag-finished(action) => {
                                    root.drag-ended();
                                }

                                row-menu := ContextMenuArea {
                                    Menu {
                                        MenuItem {
                                            title: Shortcuts.titled("이동…", Shortcuts.move-to);
                                            activated => {
                                                root.menu-command("move");
                                            }
                                        }
                                        MenuItem {
                                            title: Shortcuts.titled("복사…", Shortcuts.copy-to);
                                            activated => {
                                                root.menu-command("copy");
                                            }
                                        }
                                        MenuSeparator { }
                                        MenuItem {
                                            title: Shortcuts.titled("열기", Shortcuts.open);
                                            activated => {
                                                root.menu-command("open");
                                            }
                                        }
                                        MenuItem {
                                            title: Shortcuts.titled("이름 바꾸기", Shortcuts.rename);
                                            activated => {
                                                root.menu-command("rename");
                                            }
                                        }
                                        MenuSeparator { }
                                        MenuItem {
                                            title: Shortcuts.titled("휴지통으로 보내기", Shortcuts.trash);
                                            activated => {
                                                root.menu-command("delete");
                                            }
                                        }
                                        MenuItem {
                                            title: Shortcuts.titled("영구 삭제", Shortcuts.delete-permanently);
                                            activated => {
                                                root.menu-command("delete-permanently");
                                            }
                                        }
                                    }

                                    // It takes the right click itself, so the row is selected before its
                                    // menu opens.
                                    touch := TouchArea {
                                        pointer-event(event) => {
                                            if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                                                root.row-clicked(i, event.modifiers.control, event.modifiers.shift);
                                            }
                                            if (event.kind == PointerEventKind.down && event.button == PointerEventButton.right) {
                                                root.row-menu(i);
                                                row-menu.show({ x: self.mouse-x, y: self.mouse-y });
                                            }
                                        }
                                        // Not after a drag: the drag takes the pointer from the row.
                                        clicked => {
                                            root.row-released(i);
                                        }
                                        double-clicked => {
                                            root.row-activated(i);
                                        }
                                    }
                                }
                            }

                            // Hidden items show at half strength.
                            Rectangle {
                                opacity: row.hidden ? 0.5 : 1;

                                Icon {
                                    x: root.pad;
                                    y: (parent.height - self.height) / 2;
                                    width: 18px;
                                    height: 18px;
                                    name: row.is-link ? "link" : row.is-dir ? "folder" : "file";
                                    color: row.is-dir ? Theme.folder : Theme.muted;
                                }
                                Text {
                                    x: root.pad + root.icon-room;
                                    width: root.name-end - self.x;
                                    height: parent.height;
                                    text: row.name;
                                    color: Theme.text;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                                for column[c] in root.columns: Text {
                                    x: root.col-x(c);
                                    width: root.w(c);
                                    height: parent.height;
                                    visible: c < root.shown;
                                    text: Cells.text(row, column.id);
                                    color: Theme.muted;
                                    horizontal-alignment: column.align-end ? right : left;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                            }

                            if root.active && i == root.cursor: Rectangle {
                                x: 2px;
                                width: parent.width - 4px;
                                border-width: 1px;
                                border-color: Theme.accent;
                                border-radius: 4px;
                            }
                            // The folder a drag over this row would go into.
                            if drop.has-drag && i == drop.target-row: Rectangle {
                                x: 2px;
                                width: parent.width - 4px;
                                border-width: 2px;
                                border-color: Theme.accent;
                                border-radius: 4px;
                            }
                        }
                    }
                }
            }

            // The pane's folder takes the drag: a frame around the list.
            if drop.has-drag && drop.target-row < 0: Rectangle {
                x: 2px;
                y: 2px;
                width: parent.width - 4px;
                height: parent.height - 4px;
                border-width: 2px;
                border-color: Theme.accent;
                border-radius: Theme.radius;
            }
            // Why the drag cannot go where the pointer is.
            if !drop.has-drag && root.refusal != "": Rectangle {
                x: (parent.width - self.width) / 2;
                y: parent.height - self.height - 14px;
                width: min(refused.preferred-width + 28px, parent.width - 24px);
                height: 30px;
                border-radius: 15px;
                background: Theme.toast-bg;

                refused := Text {
                    width: parent.width - 28px;
                    text: root.refusal;
                    color: Theme.toast-text;
                    font-weight: 600;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
            // What the drop would do.
            if drop.has-drag && root.drag-label != "": Rectangle {
                x: (parent.width - self.width) / 2;
                y: parent.height - self.height - 14px;
                width: min(label.preferred-width + 28px, parent.width - 24px);
                height: 30px;
                border-radius: 15px;
                background: Theme.accent;

                label := Text {
                    width: parent.width - 28px;
                    text: root.drag-label;
                    color: Theme.on-accent;
                    font-weight: 600;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }
    }
}
