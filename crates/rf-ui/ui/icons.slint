// Line icons from the mockup: 24×24 SVG paths, 1.8px round strokes, no fill.
// Rectangles and circles of the mockup SVGs are written out as path commands.

import { Theme } from "theme.slint";

export component Icon inherits Path {
    // One of: logo, back, forward, up, new-folder, copy, move, delete, rename, undo,
    // list-view, search, folder, file, link, drive, star, plus, close, pause, play, check,
    // sort-up, sort-down, chevron-right, chevron-down, warning. Anything else draws nothing.
    in property <string> name;
    in property <brush> color: Theme.text;

    width: 20px;
    height: 20px;
    viewbox-x: 0;
    viewbox-y: 0;
    viewbox-width: 24;
    viewbox-height: 24;
    fill: transparent;
    stroke: root.color;
    stroke-width: 1.8px;
    stroke-line-cap: round;
    stroke-line-join: round;
    commands: root.commands-for(root.name);

    pure function commands-for(name: string) -> string {
        if (name == "logo") {
            return "M19 13a7 7 0 1 1-14 0a7 7 0 1 1 14 0z M6.5 8.5L5 4l4 2.2M17.5 8.5L19 4l-4 2.2 M8 13h2.5M13.5 13H16";
        }
        if (name == "back") {
            return "M15 18l-6-6 6-6";
        }
        if (name == "forward") {
            return "M9 18l6-6-6-6";
        }
        if (name == "up") {
            return "M12 19V5M5 12l7-7 7 7";
        }
        if (name == "new-folder") {
            return "M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z M12 11v5M9.5 13.5h5";
        }
        if (name == "copy") {
            return "M11 9h7a2 2 0 0 1 2 2v7a2 2 0 0 1-2 2h-7a2 2 0 0 1-2-2v-7a2 2 0 0 1 2-2z M5 15V6a2 2 0 0 1 2-2h8";
        }
        if (name == "move") {
            return "M5 12h14M13 6l6 6-6 6";
        }
        if (name == "delete") {
            return "M4 7h16M10 11v6M14 11v6M6 7l1 12a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2l1-12M9 7V4h6v3";
        }
        if (name == "rename") {
            return "M4 20h4L19 9l-4-4L4 16z";
        }
        if (name == "undo") {
            return "M9 14l-5-5 5-5 M4 9h10a6 6 0 0 1 0 12h-3";
        }
        if (name == "list-view") {
            return "M4 6h16M4 12h16M4 18h16";
        }
        if (name == "search") {
            return "M17 11a6 6 0 1 1-12 0a6 6 0 1 1 12 0z M20 20l-4.5-4.5";
        }
        if (name == "folder") {
            return "M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z";
        }
        if (name == "file") {
            return "M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z M14 3v5h5";
        }
        if (name == "link") {
            // The file outline with a bent arrow: a link to another item.
            return "M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z M14 3v5h5 M9 17v-2a3 3 0 0 1 3-3h3 M13 10l2 2-2 2";
        }
        if (name == "drive") {
            return "M5 6h14a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2z M7 14h.01M11 14h6";
        }
        if (name == "star") {
            return "M12 3.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8-5.2-2.7-5.2 2.7 1-5.8-4.3-4.1 5.9-.9z";
        }
        if (name == "plus") {
            return "M12 5v14M5 12h14";
        }
        if (name == "close") {
            return "M6 6l12 12M18 6L6 18";
        }
        if (name == "pause") {
            return "M9 5v14M15 5v14";
        }
        if (name == "play") {
            return "M7 5v14l12-7z";
        }
        if (name == "check") {
            return "M5 12.5l4.5 4.5L19 7.5";
        }
        if (name == "sort-up") {
            return "M6 15l6-6 6 6";
        }
        if (name == "sort-down") {
            return "M6 9l6 6 6-6";
        }
        if (name == "chevron-right") {
            return "M10 7l5 5-5 5";
        }
        if (name == "chevron-down") {
            return "M7 10l5 5 5-5";
        }
        if (name == "warning") {
            return "M12 3.5L2.5 20h19z M12 10v4.5 M12 17.3v.2";
        }
        return "";
    }
}
