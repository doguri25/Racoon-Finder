// The job panel in a window of its own (LAY-09): 보기 ▸ 작업 패널 ▸ 별도 창 opens it in place of
// the panel under the panes, and its close button puts the panel back there. It shows what the
// panel under the panes shows, from the same models, which Rust hands to both; its buttons are
// the same callbacks. The window is always there while that choice is on, also with no job to
// show, and says so then.
//
// The keys of the panel work here as under the panes (`panel-key`): the arrows move among the
// buttons, Space and Enter press, the panel's own keys move a job that waits, and Esc, Tab and F6
// give the keys back to the main window's panes. The window's other shortcuts are the main
// window's: a key the panel does not use does nothing here.
//
// While a dialog shows over the main window (`blocked`), the panel here takes no click and no
// key, as the panel under the panes takes none under a dialog: it dims, and a click on it asks
// for the main window, where the dialog waits (`blocked-clicked`).
//
// It shows the theme of the settings, as `NoticeWindow` does: the globals of a window are its
// own, so Rust gives it `theme-choice` as it gives the main window.

import { Palette } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { JobPanel, JobRowView, RecentRowView, HistoryRowView } from "job-panel.slint";

export component JobWindow inherits Window {
    in property <string> window-title;
    // The theme of the settings, numbered as the main window's `theme-choice`: 0 follows the
    // system, 1 is light, 2 dark, 3 high contrast.
    in property <int> theme-choice;
    // What the panel shows, named as the main window names it: the jobs a worker has taken up,
    // those that wait, the keyboard cursor, 최근 완료 and 되돌리기 기록.
    in property <[JobRowView]> job-rows;
    in property <[JobRowView]> job-queue;
    in property <int> panel-line: -1;
    in property <int> panel-button: -1;
    in property <[RecentRowView]> recent-rows;
    in property <bool> recent-open;
    in property <string> history-title;
    in property <bool> history-open;
    in property <[HistoryRowView]> history-rows;
    in property <int> history-heads;
    // A dialog shows over the main window: the panel waits for it.
    in property <bool> blocked;
    // A click on the panel while it waits.
    callback blocked-clicked();
    // A key while the window has the keys; true when the panel used it.
    callback panel-key(text: string, ctrl: bool, shift: bool, alt: bool, meta: bool) -> bool;
    callback job-pause(index: int);
    callback job-resume(index: int);
    callback job-cancel(index: int);
    callback job-move-up(index: int);
    callback job-move-down(index: int);
    callback recent-toggled();
    callback recent-cleared();
    callback recent-details(index: int);
    callback recent-save(index: int);
    callback history-toggled();
    callback history-run(redo: bool, index: int);

    // The panel takes the keys (F6 from the main window's tree).
    public function take-keys() {
        keys.focus();
    }

    // How many lines each of the panel's three lists shows at once: one in the smallest window,
    // which then holds two running jobs, a waiting one and both lists open, and one more for
    // each 150px beyond.
    private property <int> lines: clamp(floor((root.height - 460px) / 150px) + 1, 1, 8);
    private property <bool> nothing: root.job-rows.length == 0 && root.job-queue.length == 0 && root.recent-rows.length == 0 && root.history-title == "";

    title: root.window-title;
    preferred-width: 720px;
    preferred-height: 620px;
    min-width: 520px;
    min-height: 460px;
    background: Theme.panel;
    default-font-size: Theme.font-body;
    default-font-family: Theme.font-ui;
    forward-focus: keys;

    // As in the main window: the widgets' scheme, and the app's colors from it when the system's
    // setting is followed.
    private property <color> widget-background: Palette.background;
    private property <bool> system-dark: root.widget-background.to-hsv().value < 0.5;
    public function show-theme() {
        // Following the system, its scheme comes first, so that `system-dark` is the system's.
        if (root.theme-choice == 0) {
            Palette.color-scheme = ColorScheme.unknown;
        }
        Theme.pick(root.theme-choice, root.system-dark);
        if (root.theme-choice != 0) {
            Palette.color-scheme = Theme.dark ? ColorScheme.dark : ColorScheme.light;
        }
    }
    changed system-dark => {
        root.show-theme();
    }
    changed theme-choice => {
        root.show-theme();
    }

    init => {
        root.show-theme();
        keys.focus();
    }

    keys := FocusScope {
        key-pressed(event) => {
            // The dialog over the main window comes first.
            if (root.blocked) {
                return accept;
            }
            if (root.panel-key(event.text, event.modifiers.control, event.modifiers.shift, event.modifiers.alt, event.modifiers.meta)) {
                return accept;
            }
            reject
        }

        if root.nothing: Text {
            width: parent.width;
            height: parent.height;
            text: "진행 중인 작업이 없습니다";
            color: Theme.muted;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        JobPanel {
            x: 0;
            y: 0;
            width: parent.width;
            height: self.preferred-height;
            rows: root.job-rows;
            queue: root.job-queue;
            queue-lines: root.lines;
            recent: root.recent-rows;
            recent-open: root.recent-open;
            recent-lines: root.lines;
            history-title: root.history-title;
            history-open: root.history-open;
            history: root.history-rows;
            history-heads: root.history-heads;
            history-lines: root.lines;
            focus-line: keys.has-focus && !root.blocked ? root.panel-line : -1;
            focus-button: keys.has-focus && !root.blocked ? root.panel-button : -1;
            pause(index) => {
                root.job-pause(index);
            }
            resume(index) => {
                root.job-resume(index);
            }
            cancel(index) => {
                root.job-cancel(index);
            }
            move-up(index) => {
                root.job-move-up(index);
            }
            move-down(index) => {
                root.job-move-down(index);
            }
            recent-toggled => {
                root.recent-toggled();
            }
            recent-cleared => {
                root.recent-cleared();
            }
            recent-details(index) => {
                root.recent-details(index);
            }
            recent-save(index) => {
                root.recent-save(index);
            }
            history-toggled => {
                root.history-toggled();
            }
            history-run(redo, index) => {
                root.history-run(redo, index);
            }
        }

        // Over the panel while a dialog shows in the main window: it takes the clicks, and
        // asks for that window.
        if root.blocked: Rectangle {
            width: parent.width;
            height: parent.height;
            background: Theme.bg;
            opacity: 0.6;

            TouchArea {
                clicked => {
                    root.blocked-clicked();
                }
            }
        }
    }
}
