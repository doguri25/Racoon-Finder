// The name conflict window (760×560, from the mockup): what is there and what would come, side
// by side, and what to do about it (XFER-06). The safe choice, keeping both under a numbered
// name, is chosen when it opens; overwriting is offered only between two files, says what it
// does to the file that is there, and is never confirmed by Enter alone. Below the mockup's
// three choices come the two conditional ones, 더 새 파일만 덮어쓰기 and 크기가 다를 때만
// 덮어쓰기: each says what it does to this file, and with "남은 충돌에도 같은 선택 적용" the job
// decides each later conflict by the same condition. They are overwrites too: only the button
// confirms them. The window is as tall as the smallest main window (560px), so its five choices
// and its cards are set closer than the mockup's three were. With the keys: ↑↓ choose, Enter
// takes the choice (not an overwrite), Tab goes to "남은 충돌에도 같은 선택 적용" (Space flips it),
// 작업 취소 and the main button, where Space or Enter presses it, and Esc cancels the job.

import { Theme } from "theme.slint";
import { Icon } from "icons.slint";
import { PrimaryButton, OutlineButton, CheckBox, ChoiceRow, DialogFrame } from "widgets.slint";
import { DialogKeys } from "shortcuts.slint";
import { Tr } from "tr.slint";

export struct ConflictView {
    // A new question gets a new number, which resets the choice.
    serial: int,
    title: string,
    description: string,
    incoming-label: string,
    incoming-name: string,
    incoming-place: string,
    incoming-size: string,
    incoming-time: string,
    incoming-newer: bool,
    incoming-dir: bool,
    existing-label: string,
    existing-name: string,
    existing-place: string,
    existing-size: string,
    existing-time: string,
    existing-newer: bool,
    existing-dir: bool,
    can-overwrite: bool,
    // A restore from the trash (NAV-16): it never replaces what is there, so the overwrites do
    // not show; skipping, a numbered name and 작업 취소 are its choices.
    restore: bool,
    overwrite-hint: string,
    // What skipping leaves out: "이 파일은 복사하지 않습니다".
    skip-hint: string,
    rename-hint: string,
    // What 더 새 파일만 덮어쓰기 and 크기가 다를 때만 덮어쓰기 do to this file, and whether that is
    // to overwrite it.
    newer-hint: string,
    newer-overwrites: bool,
    size-hint: string,
    size-overwrites: bool,
    // What overwriting does to the file that is there, for this conflict and for all of them.
    warning-once: string,
    warning-all: string,
    // The same for a conditional overwrite that settles the remaining conflicts too.
    warning-rule-all: string,
    // The items the job has still to do, or empty.
    items-left: string,
}

// One side of the conflict.
component Card inherits Rectangle {
    in property <string> label;
    in property <string> name;
    in property <string> place;
    in property <string> size;
    in property <string> time;
    in property <bool> newer;
    in property <bool> is-dir;
    in property <bool> raised;

    border-width: 1px;
    border-color: Theme.border;
    border-radius: 12px;
    background: root.raised ? Theme.raised : transparent;
    accessible-role: groupbox;
    accessible-label: root.label;

    VerticalLayout {
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 10px;
        padding-bottom: 10px;
        spacing: 8px;

        // Its head: a line of small text (22px at 12px, more with a larger size of text).
        HorizontalLayout {
            height: max(22px, Theme.line(Theme.font-small));

            Text {
                text: root.label;
                font-size: Theme.font-small;
                font-weight: 700;
                color: Theme.muted;
                vertical-alignment: center;
            }
            Rectangle {
                horizontal-stretch: 1;
            }
            if root.newer: Rectangle {
                width: newer-text.preferred-width + 16px;
                border-radius: 11px;
                background: Theme.selection;

                newer-text := Text {
                    text: Tr.conflict-newer-badge;
                    font-size: Theme.font-small;
                    font-weight: 500;
                    color: Theme.text;
                    vertical-alignment: center;
                }
            }
        }
        HorizontalLayout {
            spacing: 10px;

            Icon {
                y: (parent.height - self.height) / 2;
                width: 28px;
                height: 28px;
                name: root.is-dir ? "folder" : "file";
                color: root.is-dir ? Theme.folder : Theme.muted;
            }
            VerticalLayout {
                horizontal-stretch: 1;

                Text {
                    text: root.name;
                    font-weight: 500;
                    color: Theme.text;
                    overflow: elide;
                }
                Text {
                    text: root.place;
                    font-size: Theme.font-small;
                    color: Theme.muted;
                    overflow: elide;
                }
            }
        }
        GridLayout {
            spacing-horizontal: 8px;
            spacing-vertical: 4px;

            Row {
                Text {
                    // 80px, or the label's own width with a larger size of text (THEME-07).
                    width: max(80px, self.preferred-width);
                    text: Tr.conflict-size-label;
                    font-size: Theme.font-note;
                    color: Theme.muted;
                }
                Text {
                    text: root.size;
                    font-size: Theme.font-note;
                    color: Theme.text;
                    overflow: elide;
                }
            }
            Row {
                Text {
                    // 80px, or the label's own width with a larger size of text (THEME-07).
                    width: max(80px, self.preferred-width);
                    text: Tr.conflict-modified-label;
                    font-size: Theme.font-note;
                    color: Theme.muted;
                }
                Text {
                    text: root.time;
                    font-size: Theme.font-note;
                    color: Theme.text;
                    overflow: elide;
                }
            }
        }
    }
}

// The foot of the dialog: "남은 충돌에도 같은 선택 적용", how many items are left, 작업 취소 and
// the main button, which says whether this file is overwritten.
component AnswerRow inherits HorizontalLayout {
    in property <bool> apply-all;
    in property <string> items-left;
    // Where the keys are, as the dialog's `on-button`.
    in property <int> on-button;
    in property <bool> overwrites-this;
    callback toggle-all();
    callback cancel();
    callback answer();

    spacing: 12px;

    VerticalLayout {
        alignment: center;

        CheckBox {
            text: Tr.conflict-apply-all;
            checked: root.apply-all;
            focused: root.on-button == 0;
            toggled => {
                root.toggle-all();
            }
        }
    }
    if root.items-left != "": Text {
        text: root.items-left;
        font-size: Theme.font-small;
        color: Theme.faint;
        vertical-alignment: center;
    }
    Rectangle {
        horizontal-stretch: 1;
    }
    VerticalLayout {
        alignment: center;

        OutlineButton {
            button-height: 40px;
            text: Tr.conflict-cancel-job;
            focused: root.on-button == 1;
            clicked => {
                root.cancel();
            }
        }
    }
    VerticalLayout {
        alignment: center;

        PrimaryButton {
            button-height: 40px;
            text: root.overwrites-this ? Tr.policy-overwrite : Tr.common-continue;
            focused: root.on-button == 2;
            clicked => {
                root.answer();
            }
        }
    }
}

export component ConflictDialog inherits DialogFrame {
    in property <ConflictView> view;
    // `choice`: 0 overwrite, 1 skip, 2 keep both under a numbered name, 3 overwrite if the file
    // that would come is newer, 4 overwrite if the sizes differ. The rows show in this order.
    callback answered(choice: int, apply-all: bool);
    // Stops the whole job.
    callback cancelled();

    // What the user picked, and for which question: a new question starts again from keeping
    // both, with "apply to all" off.
    private property <int> picked-choice: 2;
    private property <bool> picked-all;
    private property <int> picked-for: -1;
    private property <int> choice: root.picked-for == root.view.serial ? root.picked-choice : 2;
    private property <bool> apply-all: root.picked-for == root.view.serial && root.picked-all;

    // Where the keys are: -1 the choices, 0 the box, 1 작업 취소, 2 the main button. A new
    // question starts again on the choices.
    private property <int> on-button: -1;
    // Five choices, where the mockup had three of 48px: closer, to fit the window. A row of the
    // list and 4px more (36px at 보통, THEME-07); a choice with its hint takes what it needs.
    private property <length> row-height: Theme.row-height + 4px;
    private property <int> serial: root.view.serial;
    changed serial => {
        root.on-button = -1;
        flick.content-y = 0px;
    }
    // The content is taller than the dialog (THEME-07): it scrolls, under its buttons. Up to 12px
    // more than the dialog it does not: those go into the content's bottom padding, so that a
    // font whose lines are taller than this machine's (Noto Sans CJK's 1.45 times their size)
    // does not make the window scroll at 보통 and 100 %.
    private property <bool> overflowing: body.preferred-height > flick.height + 12px;
    // The height of the buttons' row at the foot, with the gap above it and the padding below.
    private property <length> foot-height: 12px + 40px + 20px;
    // The part the keys are on comes into sight, where the dialog scrolls.
    changed on-button => {
        flick.content-y = root.on-button < 0 ? 0px : min(0px, flick.height - flick.content-height);
    }
    // ↑, ↓ or a click chose another choice, or the warning under the choices changed: the choices
    // and the warning come into sight above the foot, where the dialog scrolls and the keys are on
    // the choices. Not for a new question, whose choice is the first again: it starts at the top.
    changed choice => {
        root.show-choices();
    }
    changed warning => {
        root.show-choices();
    }
    function show-choices() {
        if (!root.overflowing || root.on-button >= 0 || root.picked-for != root.view.serial) {
            return;
        }
        let room = flick.height - root.foot-height;
        let end = warning-box.y + warning-box.height;
        let lowest = min(0px, flick.height - flick.content-height);
        flick.content-y = max(lowest, min(0px, max(-choices.y, min(flick.content-y, room - end))));
    }

    width: 760px;
    height: 560px;
    accessible-label: root.view.title;
    accessible-description: root.view.description;

    init => {
        keys.focus();
    }

    // The choice chosen overwrites, always or by its condition: only the button confirms it.
    private property <bool> overwriting: root.choice == 0 || root.choice >= 3;
    // What the choice does to this file is to overwrite it: the button says so.
    private property <bool> overwrites-this: root.choice == 0 || (root.choice == 3 && root.view.newer-overwrites) || (root.choice == 4 && root.view.size-overwrites);
    // What the choice destroys, said under the choices; empty when it destroys nothing.
    private property <string> warning: root.choice == 0 ? (root.apply-all ? root.view.warning-all : root.view.warning-once) : !root.overwriting ? "" : root.apply-all ? root.view.warning-rule-all : root.overwrites-this ? root.view.warning-once : "";

    // The choice below `from` moving `step` rows. Where no overwrite is offered (a file and a
    // folder), the two rows between the overwrites take the keys alone.
    pure function step-choice(from: int, step: int) -> int {
        let lowest = root.view.can-overwrite ? 0 : 1;
        let highest = root.view.can-overwrite ? 4 : 2;
        return max(lowest, min(highest, from + step));
    }

    function pick(choice: int) {
        root.picked-all = root.apply-all;
        root.picked-choice = choice;
        root.picked-for = root.view.serial;
    }

    function toggle-all() {
        root.picked-choice = root.choice;
        root.picked-all = !root.apply-all;
        root.picked-for = root.view.serial;
    }

    keys := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.cancelled();
                return accept;
            }
            let step = DialogKeys.tab-step(event);
            if (step != 0) {
                root.on-button = DialogKeys.cycle(root.on-button + 1, step, 4) - 1;
                return accept;
            }
            if (root.on-button == 0 && event.text == " ") {
                root.toggle-all();
                return accept;
            }
            if (root.on-button == 1 && DialogKeys.presses(event)) {
                root.cancelled();
                return accept;
            }
            // The button, chosen with Tab, confirms an overwrite too.
            if (root.on-button == 2 && DialogKeys.presses(event)) {
                root.answered(root.choice, root.apply-all);
                return accept;
            }
            if (event.text == Key.UpArrow) {
                root.pick(root.step-choice(root.choice, -1));
                return accept;
            }
            if (event.text == Key.DownArrow) {
                root.pick(root.step-choice(root.choice, 1));
                return accept;
            }
            // An overwrite destroys the file that is there: only the button confirms it, a
            // conditional one too.
            if (event.text == Key.Return && !root.overwriting) {
                root.answered(root.choice, root.apply-all);
                return accept;
            }
            reject
        }

        // The dialog scrolls where its content is taller than the dialog may be (a larger
        // density or size of text in a small window, THEME-07; the wheel and a touch drag scroll
        // it), with a bar at its right edge that says so, and its buttons stay at its foot; the
        // keys bring the part they are on into sight: the top while they are on the choices, the
        // end (the warning above the buttons) on the box and the buttons. Where it fits (at 보통
        // and 100 %), nothing of this shows.
        flick := Flickable {
            content-width: self.width;
            content-height: root.overflowing ? body.preferred-height : self.height;

            body := VerticalLayout {
                width: flick.content-width;
                height: flick.content-height;
                padding-left: 28px;
                padding-right: 28px;
                padding-top: 20px;
                padding-bottom: 20px;
                spacing: 12px;

                VerticalLayout {
                    spacing: 4px;

                    Text {
                        text: root.view.title;
                        font-size: Theme.font-title;
                        font-weight: 700;
                        color: Theme.text;
                    }
                    Text {
                        text: root.view.description;
                        color: Theme.muted;
                        wrap: word-wrap;
                    }
                }

                HorizontalLayout {
                    spacing: 12px;

                    Card {
                        horizontal-stretch: 1;
                        raised: true;
                        label: root.view.incoming-label;
                        name: root.view.incoming-name;
                        place: root.view.incoming-place;
                        size: root.view.incoming-size;
                        time: root.view.incoming-time;
                        newer: root.view.incoming-newer;
                        is-dir: root.view.incoming-dir;
                    }
                    Card {
                        horizontal-stretch: 1;
                        label: root.view.existing-label;
                        name: root.view.existing-name;
                        place: root.view.existing-place;
                        size: root.view.existing-size;
                        time: root.view.existing-time;
                        newer: root.view.existing-newer;
                        is-dir: root.view.existing-dir;
                    }
                }

                choices := VerticalLayout {
                    spacing: 4px;
                    accessible-role: radio-group;
                    accessible-label: Tr.conflict-question;

                    Text {
                        text: Tr.conflict-question;
                        font-weight: 500;
                        color: Theme.text;
                    }
                    if !root.view.restore: ChoiceRow {
                        min-height: root.row-height;
                        text: Tr.policy-overwrite;
                        hint: root.view.overwrite-hint;
                        enabled: root.view.can-overwrite;
                        chosen: root.choice == 0;
                        clicked => {
                            root.pick(0);
                            keys.focus();
                        }
                    }
                    ChoiceRow {
                        min-height: root.row-height;
                        text: Tr.policy-skip;
                        hint: root.view.skip-hint;
                        chosen: root.choice == 1;
                        clicked => {
                            root.pick(1);
                            keys.focus();
                        }
                    }
                    ChoiceRow {
                        min-height: root.row-height;
                        text: Tr.conflict-choice-keep-both;
                        hint: root.view.rename-hint;
                        chosen: root.choice == 2;
                        clicked => {
                            root.pick(2);
                            keys.focus();
                        }
                    }
                    if !root.view.restore: ChoiceRow {
                        min-height: root.row-height;
                        text: Tr.policy-if-newer;
                        hint: root.view.newer-hint;
                        enabled: root.view.can-overwrite;
                        chosen: root.choice == 3;
                        clicked => {
                            root.pick(3);
                            keys.focus();
                        }
                    }
                    if !root.view.restore: ChoiceRow {
                        min-height: root.row-height;
                        text: Tr.policy-if-size-differs;
                        hint: root.view.size-hint;
                        enabled: root.view.can-overwrite;
                        chosen: root.choice == 4;
                        clicked => {
                            root.pick(4);
                            keys.focus();
                        }
                    }
                }

                // What the choice destroys, at the top of the room the rest leave: as many lines
                // as it takes (a larger size of text wraps it), at least 20px.
                warning-box := VerticalLayout {
                    vertical-stretch: 1;
                    min-height: 20px;
                    alignment: start;

                    Text {
                        text: root.warning;
                        color: Theme.text;
                        font-weight: 500;
                        wrap: word-wrap;
                    }
                }

                // The room of the row of buttons, which lies at the foot (below).
                Rectangle {
                    height: 40px;
                }
            }
        }

        // The row of buttons, at the foot: where the content fits, just where the content's
        // last row would be (the content keeps its room); where the dialog scrolls, over the
        // content that scrolls under it, with a line above it. It is the only one, so a screen
        // reader finds each of its controls once, and it takes every click on it, also on its
        // blank parts, so that none reaches a choice scrolled under it.
        Rectangle {
            x: root.border-width;
            y: root.height - root.foot-height;
            width: root.width - 2 * root.border-width;
            height: root.foot-height - root.border-width;
            background: root.overflowing ? Theme.panel : transparent;

            TouchArea { }
            if root.overflowing: Rectangle {
                y: 0;
                height: 1px;
                background: Theme.border;
            }
            AnswerRow {
                x: 28px - root.border-width;
                y: 12px;
                width: root.width - 56px;
                height: 40px;
                apply-all: root.apply-all;
                items-left: root.view.items-left;
                on-button: root.on-button;
                overwrites-this: root.overwrites-this;
                toggle-all => {
                    root.toggle-all();
                    keys.focus();
                }
                cancel => {
                    root.cancelled();
                }
                answer => {
                    root.answered(root.choice, root.apply-all);
                }
            }
        }

        // The bar that says the dialog scrolls, beside the part that does.
        if root.overflowing: Rectangle {
            private property <length> room: root.height - root.foot-height - 8px;

            x: root.width - 7px;
            y: 4px + (self.room - self.height) * (-flick.content-y / max(1px, flick.content-height - flick.height));
            width: 4px;
            height: max(24px, self.room * flick.height / flick.content-height);
            border-radius: 2px;
            background: Theme.muted;
        }
    }
}
