// One folder pane: the tab strip, the path row, the file list and the status bar. The list and
// the tabs take dragged rows: the list into the folder of the row under the pointer or of the
// pane, a tab into its folder.

import { Theme } from "theme.slint";
import { Icon } from "icons.slint";
import { FileList, FileRow } from "file-list.slint";
import { Shortcuts } from "shortcuts.slint";

export struct TabItem {
    title: string,
    active: bool,
}

// One piece of the path row; `index` counts from the root (0).
export struct Crumb {
    label: string,
    index: int,
}

// Everything a pane shows. `rows` is a Rust model updated row by row; the rest is set as a
// whole.
export struct PaneView {
    tabs: [TabItem],
    // The position of the tab that shows.
    active-tab: int,
    crumbs: [Crumb],
    path-text: string,
    rows: [FileRow],
    // The keyboard cursor's row, or -1.
    cursor: int,
    // 0 name, 1 size, 2 modified, 3 kind.
    sort-key: int,
    sort-ascending: bool,
    status: string,
    // A listing is on its way.
    loading: bool,
    // Why the folder could not be listed; empty when it could.
    error: string,
    // The pane has the keyboard.
    active: bool,
}

// Small square icon button inside a tab or a strip: its name and the key of its command
// (`keys`) show in a tooltip.
component StripButton inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <string> keys;
    in property <length> icon-size: 16px;
    callback clicked();

    width: 26px;
    height: 26px;
    border-radius: 6px;
    background: touch.pressed ? Theme.border : touch.has-hover ? Theme.raised : transparent;
    accessible-role: button;
    accessible-label: root.label;
    accessible-description: root.keys;
    accessible-action-default => {
        root.clicked();
    }

    Icon {
        width: root.icon-size;
        height: root.icon-size;
        name: root.icon;
        color: Theme.muted;
    }

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }

    // In front of the touch area, which would take the pointer from it.
    Tooltip {
        text: @markdown("\{Shortcuts.tip(root.label, root.keys)}");
    }
}

component TabButton inherits Rectangle {
    in property <TabItem> tab;
    in property <bool> closable;
    callback selected();
    callback closed();
    // A drag with the payload `data` over the tab asks for `action`: what the tab's folder
    // takes, or `none`. Then the drop itself, the same way.
    callback drop-check(data: data-transfer, action: DragAction) -> DragAction;
    callback dropped(data: data-transfer, action: DragAction) -> DragAction;

    height: 34px;
    min-width: 72px;
    max-width: 200px;
    horizontal-stretch: 0;
    border-top-left-radius: Theme.radius;
    border-top-right-radius: Theme.radius;
    background: root.tab.active ? Theme.panel : touch.has-hover ? Theme.border : transparent;
    accessible-role: AccessibleRole.tab;
    accessible-label: root.tab.title;
    accessible-item-selected: root.tab.active;
    accessible-action-default => {
        root.selected();
    }

    // Under the close button, which takes its own clicks.
    touch := TouchArea {
        clicked => {
            root.selected();
        }
        pointer-event(event) => {
            if (event.kind == PointerEventKind.up && event.button == PointerEventButton.middle) {
                root.closed();
            }
        }
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: root.closable ? 4px : 12px;
        spacing: 6px;

        Icon {
            y: (parent.height - self.height) / 2;
            width: 16px;
            height: 16px;
            name: "folder";
            color: Theme.folder;
        }
        Text {
            accessible-role: none;
            text: root.tab.title;
            color: root.tab.active ? Theme.text : Theme.muted;
            font-weight: root.tab.active ? 600 : 400;
            vertical-alignment: center;
            overflow: elide;
        }
        if root.closable: VerticalLayout {
            alignment: center;

            StripButton {
                width: 22px;
                height: 22px;
                icon: "close";
                icon-size: 14px;
                label: "탭 닫기";
                keys: Shortcuts.close-tab;
                clicked => {
                    root.closed();
                }
            }
        }
    }

    drop := DropArea {
        can-drop(event) => {
            return root.drop-check(event.data, event.proposed-action);
        }
        dropped(event) => {
            return root.dropped(event.data, event.proposed-action);
        }
    }

    // The tab's folder takes the drag.
    if drop.has-drag: Rectangle {
        border-top-left-radius: Theme.radius;
        border-top-right-radius: Theme.radius;
        border-width: 2px;
        border-color: Theme.accent;
    }
}

component CrumbButton inherits Rectangle {
    in property <string> text;
    // The name for screen readers, when it is not the text (the "…" piece's folder).
    in property <string> label: root.text;
    in property <bool> current;
    callback clicked();

    height: 28px;
    horizontal-stretch: 0;
    border-radius: 6px;
    background: touch.pressed ? Theme.border : touch.has-hover ? Theme.raised : transparent;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => {
        root.clicked();
    }

    HorizontalLayout {
        padding-left: 6px;
        padding-right: 6px;

        Text {
            accessible-role: none;
            text: root.text;
            color: Theme.text;
            font-weight: root.current ? 700 : 400;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

// The bar between the two panes (LAY-02). Dragged, it shares the room between them, the first
// pane (the left or top one) keeping from a tenth to nine tenths of it; double-clicked, it
// shares the room evenly. While it is dragged it moves on its own (`dragging`, `live-share`),
// and tells the share once, as it is let go.
export component PaneDivider inherits Rectangle {
    // Upright between panes side by side, lying between panes one above the other.
    in property <bool> upright: true;
    // The room the two panes share along the drag (the divider left out), and the first pane's
    // share of it, as Rust last set it.
    in property <length> room;
    in property <float> share;
    out property <bool> dragging;
    out property <float> live-share;
    // The divider was let go at `share`, or double-clicked (0.5).
    callback changed(share: float);

    touch := TouchArea {
        mouse-cursor: root.upright ? MouseCursor.col-resize : MouseCursor.row-resize;
        pointer-event(event) => {
            if (event.button != PointerEventButton.left) {
                return;
            }
            if (event.kind == PointerEventKind.down) {
                root.live-share = root.share;
            } else if (event.kind == PointerEventKind.up && root.dragging) {
                root.changed(root.live-share);
                root.dragging = false;
            } else if (event.kind == PointerEventKind.cancel) {
                root.dragging = false;
            }
        }
        // The first pane ends where the pointer is, less where the divider was pressed.
        moved => {
            if (root.room <= 0) {
                return;
            }
            let first = root.upright ? root.x + self.mouse-x - self.pressed-x : root.y + self.mouse-y - self.pressed-y;
            root.live-share = clamp(first / root.room, 0.1, 0.9);
            root.dragging = true;
        }
        double-clicked => {
            root.dragging = false;
            root.changed(0.5);
        }
    }

    // The grip, which lights up under the pointer.
    Rectangle {
        width: root.upright ? 4px : 40px;
        height: root.upright ? 40px : 4px;
        border-radius: 2px;
        background: touch.pressed || touch.has-hover ? Theme.accent : Theme.border;
    }
}

export component Pane inherits Rectangle {
    in property <PaneView> view;
    // The pane's name for screen readers.
    in property <string> label;
    // The payload of a drag of the rows, and what a drop on the list would do (`FileList`).
    in property <data-transfer> drag-data;
    in property <string> drag-label;
    // Why the place of the pane under a drag does not take it (`FileList.refusal`).
    in property <string> refusal;
    // The path row shows a text field instead of the crumbs.
    out property <bool> editing;
    out property <int> page-rows: files.page-rows;

    // Any click on the pane that nothing else takes.
    callback activated();
    callback tab-selected(index: int);
    callback tab-closed(index: int);
    callback tab-added();
    callback crumb-clicked(index: int);
    // Enter in the path field.
    callback path-entered(text: string);
    // Esc closed the path field. (A field that loses focus closes silently: the focus stays
    // where the click put it.)
    callback edit-ended();
    callback sort(column: int);
    // A left press on row `index`, and its release when no drag came of it.
    callback row-clicked(index: int, ctrl: bool, shift: bool);
    callback row-released(index: int);
    callback row-activated(index: int);
    // A right click on row `index`, before its menu opens; a command of the list's menus.
    callback row-menu(index: int);
    callback menu-command(name: string);
    callback retry();
    // A drag over row `index` of the list (-1 below the rows) or over tab `index`, and its
    // drop: what each takes (`FileList.drop-check`).
    callback list-drop-check(data: data-transfer, index: int, action: DragAction) -> DragAction;
    callback list-dropped(data: data-transfer, index: int, action: DragAction) -> DragAction;
    callback tab-drop-check(data: data-transfer, index: int, action: DragAction) -> DragAction;
    callback tab-dropped(data: data-transfer, index: int, action: DragAction) -> DragAction;
    // A drag of the pane's rows ended.
    callback drag-ended();

    // Shows the path as text to edit (Ctrl+L, or a click beside the crumbs), all of it
    // selected and the cursor at its end, which shows: that is where a path is edited.
    public function edit-path() {
        root.editing = true;
        path-input.text = root.view.path-text;
        path-input.focus();
        path-input.set-selection-offsets(0, 2147483647);
    }

    public function scroll-to(index: int) {
        files.scroll-to(index);
    }

    // "불러오는 중…" shows only once a listing has taken 0.3 s, so a quick one never flashes it.
    private property <bool> loading: root.view.loading;
    private property <bool> loading-shown;
    changed loading => {
        root.loading-shown = false;
    }

    background: Theme.panel;
    border-radius: Theme.radius-large;
    clip: true;
    accessible-role: groupbox;
    accessible-label: root.label;

    // The tabs share the strip, each between 120 and 168px wide; when they need more room
    // than the pane has, the strip scrolls sideways and keeps the tab that shows in view. So
    // the pane is as wide as the other one, however many tabs either has.
    private property <int> tab-count: root.view.tabs.length;
    private property <length> tab-gap: 2px;
    private property <length> tab-room: tab-strip.width - 16px - 30px;
    private property <length> tab-width: min(168px, max(120px, (root.tab-room - (root.tab-count - 1) * root.tab-gap) / max(1, root.tab-count)));
    private property <length> tabs-width: root.tab-count * root.tab-width + max(0, root.tab-count - 1) * root.tab-gap;
    private property <int> active-tab: root.view.active-tab;
    changed active-tab => {
        root.show-active-tab();
    }
    changed tabs-width => {
        root.show-active-tab();
    }
    changed tab-room => {
        root.show-active-tab();
    }

    // Scrolls the strip as little as needed to show the tab that shows whole.
    function show-active-tab() {
        let shown = min(root.tab-room, root.tabs-width);
        tabs-view.content-x = max(min(0px, shown - root.tabs-width), min(0px, tabs-view.content-x));
        let left = root.active-tab * (root.tab-width + root.tab-gap);
        if (left + tabs-view.content-x < 0) {
            tabs-view.content-x = -left;
        } else if (left + root.tab-width + tabs-view.content-x > shown) {
            tabs-view.content-x = shown - left - root.tab-width;
        }
    }

    Timer {
        interval: 300ms;
        running: root.loading && !root.loading-shown;
        triggered => {
            root.loading-shown = true;
        }
    }

    TouchArea {
        clicked => {
            root.activated();
        }
    }

    VerticalLayout {
        // Tab strip.
        tab-strip := Rectangle {
            height: 40px;
            background: Theme.raised;

            tabs-view := Flickable {
                x: 8px;
                y: 6px;
                width: min(root.tab-room, root.tabs-width);
                height: 34px;
                content-width: root.tabs-width;
                interactive: root.tabs-width > root.tab-room;

                for tab[i] in root.view.tabs: TabButton {
                    x: i * (root.tab-width + root.tab-gap);
                    width: root.tab-width;
                    tab: tab;
                    closable: root.view.tabs.length > 1;
                    selected => {
                        root.tab-selected(i);
                    }
                    closed => {
                        root.tab-closed(i);
                    }
                    drop-check(data, action) => {
                        return root.tab-drop-check(data, i, action);
                    }
                    dropped(data, action) => {
                        return root.tab-dropped(data, i, action);
                    }
                }
            }
            StripButton {
                x: tabs-view.x + tabs-view.width + 2px;
                y: tabs-view.y + (tabs-view.height - self.height) / 2;
                icon: "plus";
                label: "새 탭";
                keys: Shortcuts.new-tab;
                clicked => {
                    root.tab-added();
                }
            }

            Rectangle {
                y: parent.height - self.height;
                height: 1px;
                background: Theme.border;
            }
        }

        // Path row: the crumbs, or the path as text while editing.
        Rectangle {
            height: 38px;
            accessible-role: groupbox;
            accessible-label: "경로";

            // A click beside the crumbs makes the pane active and edits the path.
            TouchArea {
                visible: !root.editing;
                clicked => {
                    root.activated();
                    root.edit-path();
                }
            }

            crumb-view := Rectangle {
                // Where the strip would start to end at the right edge of the row: before it
                // when the path is too long. And how much further left the strip goes then, so
                // that the first folder shown follows the "…" piece with no gap (the piece the
                // "…" stands in sets it).
                property <length> end-x: min(0px, self.width - crumb-strip.preferred-width);
                property <length> lead;

                x: 6px;
                width: parent.width - 12px;
                visible: !root.editing;
                clip: true;

                // Too long for the row, the path keeps its last folders in view. A folder that
                // does not fit whole is not shown cut: the folders left of the first one that
                // fits are hidden, and the last of them gives its place to a "…" piece that
                // goes to it (the nearest folder out of view). The "…" piece starts the row,
                // and the folders shown follow it.
                crumb-strip := HorizontalLayout {
                    x: crumb-view.end-x < 0 ? crumb-view.end-x - crumb-view.lead : 0px;
                    width: self.preferred-width;
                    alignment: start;
                    spacing: 0px;

                    for crumb[i] in root.view.crumbs: Rectangle {
                        // Where the piece would be in the row ending at its right edge, and
                        // whether the row is cut on the left.
                        property <length> left: crumb-view.end-x + self.x;
                        property <bool> cut: crumb-view.end-x < 0;
                        property <length> room: 30px;
                        property <bool> hidden: self.cut && self.left < self.room;
                        property <bool> stands-for-hidden: self.hidden && self.left + self.width >= self.room;
                        // For the piece the "…" stands in: how much further left the strip goes
                        // for the folder after it to start right after the "…" (-1px for the
                        // others).
                        property <length> lead: self.stands-for-hidden ? self.left + self.width - self.room : -1px;

                        init => {
                            if (self.lead >= 0) {
                                crumb-view.lead = self.lead;
                            }
                        }
                        changed lead => {
                            if (self.lead >= 0) {
                                crumb-view.lead = self.lead;
                            }
                        }

                        // Hidden, it keeps its place in the row, which tells where each
                        // piece is.
                        Rectangle {
                            visible: !parent.hidden;

                            HorizontalLayout {
                                spacing: 0px;

                                if i > 0: Text {
                                    text: "›";
                                    color: Theme.muted;
                                    vertical-alignment: center;
                                }
                                VerticalLayout {
                                    alignment: center;

                                    CrumbButton {
                                        text: crumb.label;
                                        current: i == root.view.crumbs.length - 1;
                                        clicked => {
                                            root.crumb-clicked(crumb.index);
                                        }
                                    }
                                }
                            }
                        }
                        if self.stands-for-hidden: CrumbButton {
                            // At the start of the row.
                            x: parent.width - parent.room;
                            y: (parent.height - self.height) / 2;
                            width: parent.room;
                            text: "…";
                            label: crumb.label;
                            clicked => {
                                root.crumb-clicked(crumb.index);
                            }
                        }
                    }
                }
            }

            Rectangle {
                x: 8px;
                y: 4px;
                width: parent.width - 16px;
                height: parent.height - 8px;
                visible: root.editing;
                border-width: 1px;
                border-color: Theme.accent;
                border-radius: 6px;
                background: Theme.bg;

                // A long path scrolls sideways inside, to keep the cursor in view.
                Rectangle {
                    x: 8px;
                    width: parent.width - 16px;
                    clip: true;

                    path-input := TextInput {
                        property <length> computed-x;
                        // An input method composing a syllable: it is not in the text until it is
                        // committed, so Enter meanwhile does not take the path.
                        property <bool> composing: self.preedit-text != "";

                        x: min(0px, max(parent.width - self.width - self.text-cursor-width, self.computed-x));
                        width: max(parent.width - self.text-cursor-width, self.preferred-width);
                        height: parent.height;
                        color: Theme.text;
                        selection-background-color: Theme.selection;
                        selection-foreground-color: Theme.text;
                        vertical-alignment: center;
                        single-line: true;
                        accessible-role: text-input;
                        accessible-label: "경로";
                        cursor-position-changed(cursor-position) => {
                            if (cursor-position.x + self.computed-x < 0px) {
                                self.computed-x = -cursor-position.x;
                            } else if (cursor-position.x + self.computed-x > parent.width - self.text-cursor-width) {
                                self.computed-x = parent.width - cursor-position.x - self.text-cursor-width;
                            }
                        }
                        accepted => {
                            if (self.composing) {
                                return;
                            }
                            root.editing = false;
                            root.path-entered(self.text);
                        }
                        key-pressed(event) => {
                            if (event.text == Key.Escape) {
                                root.editing = false;
                                root.edit-ended();
                                return accept;
                            }
                            reject
                        }
                        // Focus went elsewhere (a click on the other pane's path, a row, a
                        // tab): the field closes and leaves the focus where it went.
                        changed has-focus => {
                            if (!self.has-focus && root.editing) {
                                root.editing = false;
                            }
                        }
                    }
                }
            }

            Rectangle {
                y: parent.height - self.height;
                height: 1px;
                background: Theme.border;
            }
        }

        // The list, or why there is none.
        Rectangle {
            vertical-stretch: 1;

            files := FileList {
                visible: root.view.error == "";
                rows: root.view.rows;
                cursor: root.view.cursor;
                sort-key: root.view.sort-key;
                sort-ascending: root.view.sort-ascending;
                active: root.view.active;
                drag-data: root.drag-data;
                drag-label: root.drag-label;
                refusal: root.refusal;
                drag-ended => {
                    root.drag-ended();
                }
                sort(column) => {
                    root.sort(column);
                }
                row-clicked(index, ctrl, shift) => {
                    root.row-clicked(index, ctrl, shift);
                }
                row-released(index) => {
                    root.row-released(index);
                }
                drop-check(data, index, action) => {
                    return root.list-drop-check(data, index, action);
                }
                dropped(data, index, action) => {
                    return root.list-dropped(data, index, action);
                }
                row-activated(index) => {
                    root.row-activated(index);
                }
                row-menu(index) => {
                    root.row-menu(index);
                }
                menu-command(name) => {
                    root.menu-command(name);
                }
            }

            if root.view.loading && root.loading-shown && root.view.rows.length == 0 && root.view.error == "": Text {
                y: 64px;
                height: 24px;
                text: "불러오는 중…";
                color: Theme.muted;
                horizontal-alignment: center;
            }

            if root.view.error != "": VerticalLayout {
                alignment: center;
                padding: Theme.gap-l;
                spacing: Theme.gap-s;

                Text {
                    text: "이 폴더를 열 수 없습니다";
                    font-size: 16px;
                    font-weight: 700;
                    color: Theme.text;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
                Text {
                    text: root.view.error;
                    color: Theme.muted;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    alignment: center;
                    padding-top: Theme.gap-s;

                    retry-button := Rectangle {
                        height: 32px;
                        border-width: 1px;
                        border-color: Theme.border;
                        border-radius: Theme.radius;
                        background: retry-touch.pressed ? Theme.border : retry-touch.has-hover ? Theme.raised : transparent;
                        accessible-role: button;
                        accessible-label: "다시 시도";
                        accessible-action-default => {
                            root.retry();
                        }

                        HorizontalLayout {
                            padding-left: Theme.gap-l;
                            padding-right: Theme.gap-l;

                            Text {
                                accessible-role: none;
                                text: "다시 시도";
                                color: Theme.text;
                                vertical-alignment: center;
                            }
                        }

                        retry-touch := TouchArea {
                            clicked => {
                                root.retry();
                            }
                        }
                    }
                }
            }
        }

        // Status bar.
        Rectangle {
            height: 32px;

            Rectangle {
                y: 0;
                height: 1px;
                background: Theme.border;
            }

            Text {
                x: 16px;
                width: parent.width - 32px;
                text: root.view.status;
                font-size: Theme.font-small;
                color: Theme.muted;
                vertical-alignment: center;
                overflow: elide;
            }
        }
    }

    // The frame goes over the content: 2px accent on the pane with the keyboard, else 1px.
    Rectangle {
        border-radius: Theme.radius-large;
        border-width: root.view.active ? 2px : 1px;
        border-color: root.view.active ? Theme.accent : Theme.border;
    }
}
