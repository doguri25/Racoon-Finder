// Buttons, progress bar, toast and one-line text field of the demo UI. Buttons are a
// TouchArea plus accessible-* properties, not a FocusScope: keyboard focus stays with the
// window's key handler, or with the dialog's, which shows the button its keys are on
// (`focused`). A toolbar button shows its name and the key of its command (`keys`, KEY-03) in a
// tooltip, and gives the key to screen readers as its description.

import { Theme } from "theme.slint";
import { Icon } from "icons.slint";
import { Shortcuts } from "shortcuts.slint";

// Icon-only 32×32 button. `label` is required: it is the button's only name for
// screen readers.
export component ToolButton inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <bool> enabled: true;
    // The key of the button's command, as the system writes it; empty for none.
    in property <string> keys;
    callback clicked();

    width: 32px;
    height: 32px;
    border-radius: Theme.radius;
    background: !root.enabled ? transparent : touch.pressed ? Theme.border : touch.has-hover ? Theme.raised : transparent;
    accessible-role: button;
    accessible-label: root.label;
    accessible-description: root.keys;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        if (root.enabled) {
            root.clicked();
        }
    }

    Icon {
        name: root.icon;
        color: root.enabled ? Theme.text : Theme.faint;
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            root.clicked();
        }
    }

    // In front of the touch area, which would take the pointer from it.
    Tooltip {
        text: @markdown("\{Shortcuts.tip(root.label, root.keys)}");
    }
}

// Flat button with an optional icon in front of its text. `compact` shows the icon
// alone (the text stays its accessible name) where a toolbar runs out of room.
export component TextButton inherits Rectangle {
    in property <string> icon;
    in property <string> text;
    in property <bool> enabled: true;
    in property <bool> compact;
    // The key of the button's command, as the system writes it; empty for none.
    in property <string> keys;
    callback clicked();

    height: 32px;
    horizontal-stretch: 0;
    border-radius: Theme.radius;
    background: !root.enabled ? transparent : touch.pressed ? Theme.border : touch.has-hover ? Theme.raised : transparent;
    accessible-role: button;
    accessible-label: root.text;
    accessible-description: root.keys;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        if (root.enabled) {
            root.clicked();
        }
    }

    HorizontalLayout {
        padding-left: Theme.gap-m;
        padding-right: Theme.gap-m;
        spacing: Theme.gap-s;
        alignment: center;

        if root.icon != "": Icon {
            y: (parent.height - self.height) / 2;
            width: 18px;
            height: 18px;
            name: root.icon;
            color: root.enabled ? Theme.text : Theme.faint;
        }
        if !root.compact || root.icon == "": Text {
            text: root.text;
            color: root.enabled ? Theme.text : Theme.faint;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            root.clicked();
        }
    }

    // In front of the touch area, which would take the pointer from it. Its name too: a
    // compact button shows its icon alone.
    if root.keys != "" || root.compact: Tooltip {
        text: @markdown("\{Shortcuts.tip(root.text, root.keys)}");
    }
}

// The one emphasized action of a dialog: accent background, on-accent text.
export component PrimaryButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    in property <length> button-height: 32px;
    // The keys of the dialog are on this button: a ring shows it.
    in property <bool> focused: false;
    callback clicked();

    height: root.button-height;
    horizontal-stretch: 0;
    border-radius: Theme.radius;
    background: !root.enabled ? Theme.border : touch.pressed ? Theme.accent.darker(0.2) : touch.has-hover ? Theme.accent.darker(0.1) : Theme.accent;
    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        if (root.enabled) {
            root.clicked();
        }
    }

    HorizontalLayout {
        padding-left: Theme.gap-l;
        padding-right: Theme.gap-l;
        alignment: center;

        Text {
            text: root.text;
            color: root.enabled ? Theme.on-accent : Theme.faint;
            font-weight: 600;
            vertical-alignment: center;
        }
    }

    if root.focused: Rectangle {
        x: -3px;
        y: -3px;
        width: root.width + 6px;
        height: root.height + 6px;
        border-width: 2px;
        border-color: Theme.accent;
        border-radius: root.border-radius + 3px;
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            root.clicked();
        }
    }
}

// Thin bar filled to `value` (0..1).
export component ProgressBar inherits Rectangle {
    in property <float> value;
    in property <brush> bar-color: Theme.accent;

    height: 6px;
    border-radius: self.height / 2;
    background: Theme.border;
    accessible-role: progress-indicator;
    accessible-value: clamp(root.value, 0, 1);
    accessible-value-minimum: 0;
    accessible-value-maximum: 1;

    Rectangle {
        x: 0;
        y: 0;
        width: parent.width * clamp(root.value, 0, 1);
        height: parent.height;
        border-radius: parent.border-radius;
        background: root.bar-color;
    }
}

// Text-only button on the dark toast background.
component ToastButton inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <string> label;
    callback clicked();

    min-width: 32px;
    height: 32px;
    border-radius: Theme.radius;
    background: touch.pressed ? #FFFFFF33 : touch.has-hover ? #FFFFFF1F : transparent;
    accessible-role: button;
    accessible-label: root.label != "" ? root.label : root.text;
    accessible-action-default => {
        root.clicked();
    }

    HorizontalLayout {
        padding-left: root.text != "" ? Theme.gap-m : 0;
        padding-right: root.text != "" ? Theme.gap-m : 0;
        alignment: center;

        if root.icon != "": Icon {
            y: (parent.height - self.height) / 2;
            width: 16px;
            height: 16px;
            name: root.icon;
            color: Theme.toast-text;
        }
        if root.text != "": Text {
            text: root.text;
            color: Theme.toast-link;
            font-weight: 700;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

// Notice in the lower right corner: a message, an optional action (`action` is its
// label; empty hides it) and a close button. `hovered` while the pointer is over it, its
// buttons included.
export component Toast inherits Rectangle {
    in property <string> message;
    in property <string> action;
    out property <bool> hovered: hover.has-hover;
    callback action-clicked();
    callback closed();

    preferred-width: layout.preferred-width;
    preferred-height: layout.preferred-height;
    border-radius: 12px;
    background: Theme.toast-bg;
    drop-shadow-blur: 24px;
    drop-shadow-offset-y: 8px;
    drop-shadow-color: #0000003D;
    accessible-role: text;
    accessible-label: root.message;

    // Under the buttons, which are inside it: it keeps its hover over them.
    hover := TouchArea {
        layout := HorizontalLayout {
            padding-left: 18px;
            padding-right: 6px;
            padding-top: 6px;
            padding-bottom: 6px;
            spacing: Theme.gap-s;

            Text {
                text: root.message;
                color: Theme.toast-text;
                vertical-alignment: center;
            }
            if root.action != "": ToastButton {
                text: root.action;
                clicked => {
                    root.action-clicked();
                }
            }
            ToastButton {
                icon: "close";
                label: "알림 닫기";
                clicked => {
                    root.closed();
                }
            }
        }
    }
}

// Bordered button of the job panel and the dialogs (the mockup's secondary action).
export component OutlineButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    in property <length> button-height: 36px;
    // The keys of the dialog are on this button: its border shows it.
    in property <bool> focused: false;
    callback clicked();

    height: root.button-height;
    min-width: 64px;
    horizontal-stretch: 0;
    border-width: root.focused ? 2px : 1px;
    border-color: root.focused ? Theme.accent : Theme.border;
    border-radius: 10px;
    background: !root.enabled ? transparent : touch.pressed ? Theme.border : touch.has-hover ? Theme.raised : transparent;
    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        if (root.enabled) {
            root.clicked();
        }
    }

    HorizontalLayout {
        padding-left: Theme.gap-l;
        padding-right: Theme.gap-l;
        alignment: center;

        Text {
            accessible-role: none;
            text: root.text;
            color: root.enabled ? Theme.text : Theme.faint;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            root.clicked();
        }
    }
}

// Square box with a check mark and its label; a click asks the owner to flip `checked`.
export component CheckBox inherits Rectangle {
    in property <string> text;
    in property <bool> checked;
    // The keys of the dialog are on this box: a ring shows it.
    in property <bool> focused: false;
    callback toggled();

    min-height: 36px;
    accessible-role: checkbox;
    accessible-label: root.text;
    accessible-checkable: true;
    accessible-checked: root.checked;
    accessible-action-default => {
        root.toggled();
    }

    HorizontalLayout {
        spacing: 10px;

        VerticalLayout {
            alignment: center;

            Rectangle {
                width: 18px;
                height: 18px;
                border-radius: 4px;
                border-width: root.checked ? 0 : 1.5px;
                border-color: Theme.muted;
                background: root.checked ? Theme.accent : transparent;

                if root.checked: Icon {
                    width: 14px;
                    height: 14px;
                    name: "check";
                    color: Theme.on-accent;
                }
                if root.focused: Rectangle {
                    x: -4px;
                    y: -4px;
                    width: parent.width + 8px;
                    height: parent.height + 8px;
                    border-width: 2px;
                    border-color: Theme.accent;
                    border-radius: 7px;
                }
            }
        }
        Text {
            accessible-role: none;
            text: root.text;
            color: Theme.text;
            vertical-alignment: center;
        }
    }

    TouchArea {
        clicked => {
            root.toggled();
        }
    }
}

// One choice of a set (a radio row of the mockup): its label, a hint after it, and the
// accent frame while it is the one chosen. A row that is not `enabled` shows faint and takes
// no click.
export component ChoiceRow inherits Rectangle {
    in property <string> text;
    in property <string> hint;
    in property <bool> chosen;
    in property <bool> enabled: true;
    callback clicked();

    min-height: 48px;
    border-width: 1px;
    border-radius: 10px;
    border-color: root.chosen ? Theme.accent : Theme.border;
    background: root.chosen ? Theme.selection : touch.has-hover && root.enabled ? Theme.raised : transparent;
    accessible-role: radio-button;
    accessible-label: root.text;
    accessible-description: root.hint;
    accessible-enabled: root.enabled;
    accessible-checkable: true;
    accessible-checked: root.chosen;
    accessible-action-default => {
        if (root.enabled) {
            root.clicked();
        }
    }

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 12px;

        VerticalLayout {
            alignment: center;

            Rectangle {
                width: 18px;
                height: 18px;
                border-radius: 9px;
                border-width: root.chosen ? 5px : 1.5px;
                border-color: root.chosen ? Theme.accent : root.enabled ? Theme.muted : Theme.faint;
            }
        }
        Text {
            accessible-role: none;
            text: root.text;
            font-weight: 500;
            color: root.enabled ? Theme.text : Theme.faint;
            vertical-alignment: center;
        }
        Text {
            accessible-role: none;
            horizontal-stretch: 1;
            text: root.hint;
            font-size: 13px;
            color: root.enabled ? Theme.muted : Theme.faint;
            vertical-alignment: center;
            overflow: elide;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            root.clicked();
        }
    }
}

// One choice of a few shown side by side (move or copy, what a name conflict does, how a
// pattern is written).
export component Segment inherits Rectangle {
    in property <string> text;
    in property <bool> chosen;
    callback clicked();

    height: 30px;
    min-width: label.preferred-width + 24px;
    horizontal-stretch: 0;
    border-radius: 6px;
    background: root.chosen ? Theme.panel : touch.has-hover ? Theme.border : transparent;
    drop-shadow-blur: root.chosen ? 3px : 0px;
    drop-shadow-color: #00000029;
    accessible-role: radio-button;
    accessible-label: root.text;
    accessible-checkable: true;
    accessible-checked: root.chosen;
    accessible-action-default => {
        root.clicked();
    }

    label := Text {
        accessible-role: none;
        text: root.text;
        color: root.chosen ? Theme.text : Theme.muted;
        font-weight: root.chosen ? 600 : 400;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

// The track the segments of one set sit in; a ring while the keys are on it.
export component SegmentTrack inherits Rectangle {
    in property <string> label;
    in property <bool> focused;

    horizontal-stretch: 0;
    border-radius: 8px;
    border-width: root.focused ? 2px : 0px;
    border-color: Theme.accent;
    background: Theme.raised;
    accessible-role: radio-group;
    accessible-label: root.label;

    HorizontalLayout {
        padding: 3px;
        spacing: 2px;

        @children
    }
}

// The frame every dialog sits in: the panel color, rounded corners and a shadow over the
// scrim.
export component DialogFrame inherits Rectangle {
    background: Theme.panel;
    border-radius: 12px;
    drop-shadow-blur: 32px;
    drop-shadow-offset-y: 12px;
    drop-shadow-color: #00000052;
    clip: true;
    accessible-role: groupbox;
}

// A one-line text field with a faint hint while it is empty.
export component Field inherits Rectangle {
    in property <string> hint;
    in property <string> icon;
    in property <string> label;
    in-out property <string> text <=> input.text;
    // An input method is composing text in the field (a Korean syllable not yet complete): it
    // shows at the cursor but is not in `text`, and `edited` comes only once it is committed.
    // Enter meanwhile is not `accepted`: it would take the text without the syllable.
    out property <bool> composing: input.preedit-text != "";
    out property <bool> has-focus: input.has-focus;
    // A key the field does not take itself; return `accept` to stop it there.
    callback key(event: KeyEvent) -> EventResult;
    callback edited(text: string);
    callback accepted(text: string);

    public function take-focus() {
        input.focus();
    }

    // Takes the keys with all its text selected, so that what is typed replaces it.
    public function take-focus-all() {
        input.focus();
        input.select-all();
    }

    // Puts the cursor after the text.
    public function to-end() {
        input.set-selection-offsets(2147483647, 2147483647);
    }

    height: 36px;
    horizontal-stretch: 1;
    border-width: 1px;
    border-color: input.has-focus ? Theme.accent : Theme.border;
    border-radius: Theme.radius;
    background: Theme.bg;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 8px;

        if root.icon != "": Icon {
            y: (parent.height - self.height) / 2;
            width: 16px;
            height: 16px;
            name: root.icon;
            color: Theme.muted;
        }
        // The field takes the room it is given: a long path neither widens it nor its
        // dialog, it scrolls inside.
        Rectangle {
            min-width: 0px;
            preferred-width: 0px;
            horizontal-stretch: 1;
            clip: true;

            if input.text == "" && !root.composing: Text {
                width: 100%;
                height: 100%;
                accessible-role: none;
                text: root.hint;
                color: Theme.faint;
                vertical-alignment: center;
                overflow: elide;
            }
            // Scrolls sideways to keep the cursor in view, as the standard line edit does.
            input := TextInput {
                property <length> computed-x;

                x: min(0px, max(parent.width - self.width - self.text-cursor-width, self.computed-x));
                width: max(parent.width - self.text-cursor-width, self.preferred-width);
                height: 100%;
                color: Theme.text;
                selection-background-color: Theme.selection;
                selection-foreground-color: Theme.text;
                vertical-alignment: center;
                single-line: true;
                accessible-role: text-input;
                accessible-label: root.label;
                cursor-position-changed(cursor-position) => {
                    if (cursor-position.x + self.computed-x < 0px) {
                        self.computed-x = -cursor-position.x;
                    } else if (cursor-position.x + self.computed-x > parent.width - self.text-cursor-width) {
                        self.computed-x = parent.width - cursor-position.x - self.text-cursor-width;
                    }
                }
                key-pressed(event) => {
                    return root.key(event);
                }
                edited => {
                    root.edited(self.text);
                }
                accepted => {
                    if (!root.composing) {
                        root.accepted(self.text);
                    }
                }
            }
        }
    }
}
