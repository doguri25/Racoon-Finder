// The destination picker of a copy or a move (PICK, from the mockup): what goes where at the
// top with the move/copy toggle, the path of the target and 새 폴더, the folder tree with its
// filter on the left, the quick targets on the right, and at the bottom what a name conflict
// does, the room free at the target and the buttons. It takes the keyboard when it shows:
// letters go to the filter, ↑↓ move among the quick targets, Enter confirms (the first folder
// a filter finds first), Esc cancels. Rust decides what Enter does, and never confirms an
// overwrite with it: only the button does. A path typed into the path field and not entered
// turns the button off until it is entered (or another folder is chosen): the button never
// sends the items anywhere else than where the field says.

import { ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Icon } from "icons.slint";
import { ToolButton, PrimaryButton, OutlineButton, DialogFrame } from "widgets.slint";
import { Sidebar, TreeRow } from "sidebar.slint";

// One quick target, as Rust makes it.
export struct PickTarget {
    // The head over the first target of a group ("반대편 패널"); empty for the others.
    head: string,
    label: string,
    // The path, or why it cannot be chosen.
    note: string,
    enabled: bool,
    selected: bool,
}

// Everything the picker shows. The lists are Rust models updated row by row.
export struct PickView {
    title: string,
    summary: string,
    // The names of the first items, and how many more there are ("외 2개"; empty for none).
    chips: [string],
    more: string,
    is-move: bool,
    // The target's path, for the path field.
    target-path: string,
    // Why the path typed cannot be the target; empty when nothing is wrong with it.
    path-error: string,
    // The field holds a path typed and not entered; once Rust clears this, the field shows the
    // target's path again.
    path-edited: bool,
    can-make-folder: bool,
    filter: string,
    tree: [TreeRow],
    // What the tree says instead of rows (a filter that finds nothing); empty with rows.
    tree-note: string,
    targets: [PickTarget],
    // 0 물어보기, 1 덮어쓰기, 2 건너뛰기, 3 이름 바꾸기.
    policy: int,
    policy-note: string,
    // The policy destroys files: its note stands out.
    policy-danger: bool,
    // The room free at the target, once known.
    space: string,
    // Why the target cannot be chosen, or what to beware of; empty for neither.
    problem: string,
    // How the picker confirms now: the path typed must be entered first, it is being looked
    // at, or an overwrite takes the button; empty for none of these.
    hint: string,
    confirm-text: string,
    can-confirm: bool,
}

// One choice of a few shown side by side (move or copy, what a name conflict does).
component Segment inherits Rectangle {
    in property <string> text;
    in property <bool> chosen;
    callback clicked();

    height: 30px;
    min-width: label.preferred-width + 24px;
    horizontal-stretch: 0;
    border-radius: 6px;
    background: root.chosen ? Theme.panel : touch.has-hover ? Theme.border : transparent;
    drop-shadow-blur: root.chosen ? 3px : 0px;
    drop-shadow-color: #00000029;
    accessible-role: radio-button;
    accessible-label: root.text;
    accessible-checkable: true;
    accessible-checked: root.chosen;
    accessible-action-default => {
        root.clicked();
    }

    label := Text {
        accessible-role: none;
        text: root.text;
        color: root.chosen ? Theme.text : Theme.muted;
        font-weight: root.chosen ? 600 : 400;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

// The track the segments of one set sit in.
component SegmentTrack inherits Rectangle {
    in property <string> label;

    horizontal-stretch: 0;
    border-radius: 8px;
    background: Theme.raised;
    accessible-role: radio-group;
    accessible-label: root.label;

    HorizontalLayout {
        padding: 3px;
        spacing: 2px;

        @children
    }
}

// A one-line text field with a faint hint while it is empty.
component Field inherits Rectangle {
    in property <string> hint;
    in property <string> icon;
    in property <string> label;
    in-out property <string> text <=> input.text;
    // A key the field does not take itself; return `accept` to stop it there.
    callback key(event: KeyEvent) -> EventResult;
    callback edited(text: string);
    callback accepted(text: string);

    public function take-focus() {
        input.focus();
    }

    // Puts the cursor after the text.
    public function to-end() {
        input.set-selection-offsets(2147483647, 2147483647);
    }

    height: 36px;
    horizontal-stretch: 1;
    border-width: 1px;
    border-color: input.has-focus ? Theme.accent : Theme.border;
    border-radius: Theme.radius;
    background: Theme.bg;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 8px;

        if root.icon != "": Icon {
            y: (parent.height - self.height) / 2;
            width: 16px;
            height: 16px;
            name: root.icon;
            color: Theme.muted;
        }
        // The field takes the room it is given: a long path neither widens it nor its
        // dialog, it scrolls inside.
        Rectangle {
            min-width: 0px;
            preferred-width: 0px;
            horizontal-stretch: 1;
            clip: true;

            if input.text == "": Text {
                width: 100%;
                height: 100%;
                accessible-role: none;
                text: root.hint;
                color: Theme.faint;
                vertical-alignment: center;
                overflow: elide;
            }
            // Scrolls sideways to keep the cursor in view, as the standard line edit does.
            input := TextInput {
                property <length> computed-x;

                x: min(0px, max(parent.width - self.width - self.text-cursor-width, self.computed-x));
                width: max(parent.width - self.text-cursor-width, self.preferred-width);
                height: 100%;
                color: Theme.text;
                selection-background-color: Theme.selection;
                selection-foreground-color: Theme.text;
                vertical-alignment: center;
                single-line: true;
                accessible-role: text-input;
                accessible-label: root.label;
                cursor-position-changed(cursor-position) => {
                    if (cursor-position.x + self.computed-x < 0px) {
                        self.computed-x = -cursor-position.x;
                    } else if (cursor-position.x + self.computed-x > parent.width - self.text-cursor-width) {
                        self.computed-x = parent.width - cursor-position.x - self.text-cursor-width;
                    }
                }
                key-pressed(event) => {
                    return root.key(event);
                }
                edited => {
                    root.edited(self.text);
                }
                accepted => {
                    root.accepted(self.text);
                }
            }
        }
    }
}

// The name of one of the items.
component Chip inherits Rectangle {
    in property <string> text;

    height: 24px;
    min-width: 48px;
    max-width: 180px;
    horizontal-stretch: 0;
    border-radius: 12px;
    background: Theme.raised;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;

        Text {
            text: root.text;
            font-size: Theme.font-small;
            color: Theme.text;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

// One quick target, under its group's head when it is the group's first.
component TargetItem inherits Rectangle {
    in property <PickTarget> item;
    in property <int> index;
    callback clicked();
    // The row became the target: where it is in the list, for the list to bring it into view.
    callback chosen(top: length, bottom: length);

    private property <length> head-height: root.item.head == "" ? 0px : root.index == 0 ? 28px : 38px;
    private property <bool> selected: root.item.selected;
    changed selected => {
        if (root.selected) {
            root.chosen(root.y, root.y + root.height);
        }
    }

    height: root.head-height + 50px;

    if root.item.head != "": Text {
        x: 14px;
        y: root.head-height - self.height - 6px;
        text: root.item.head;
        font-size: Theme.font-small;
        font-weight: 700;
        color: Theme.muted;
    }

    Rectangle {
        x: 6px;
        y: root.head-height;
        width: parent.width - 12px;
        height: 48px;
        border-radius: Theme.radius;
        background: root.item.selected ? Theme.selection : touch.has-hover && root.item.enabled ? Theme.raised : transparent;
        accessible-role: list-item;
        accessible-label: root.item.label;
        accessible-description: root.item.note;
        accessible-enabled: root.item.enabled;
        accessible-item-index: root.index;
        accessible-item-selectable: root.item.enabled;
        accessible-item-selected: root.item.selected;
        accessible-action-default => {
            if (root.item.enabled) {
                root.clicked();
            }
        }

        touch := TouchArea {
            enabled: root.item.enabled;
            clicked => {
                root.clicked();
            }
        }

        HorizontalLayout {
            padding-left: 10px;
            padding-right: 10px;
            spacing: 10px;

            Icon {
                y: (parent.height - self.height) / 2;
                width: 20px;
                height: 20px;
                name: "folder";
                color: root.item.enabled ? Theme.folder : Theme.faint;
            }
            VerticalLayout {
                alignment: center;
                spacing: 2px;

                Text {
                    accessible-role: none;
                    text: root.item.label;
                    color: root.item.enabled ? Theme.text : Theme.faint;
                    font-weight: root.item.selected ? 600 : 400;
                    overflow: elide;
                }
                Text {
                    accessible-role: none;
                    text: root.item.note;
                    font-size: Theme.font-small;
                    color: root.item.enabled ? Theme.muted : Theme.faint;
                    overflow: elide;
                }
            }
        }
    }
}

export component PickDialog inherits DialogFrame {
    in property <PickView> view;
    // The picker has the keyboard: no other window shows over it.
    in property <bool> active: true;
    // The tree scrolls to row `scroll-row` each time `scroll-serial` changes.
    in property <int> scroll-row;
    in property <int> scroll-serial;
    callback cancelled();
    callback confirmed();
    // Enter anywhere but in the path field.
    callback enter();
    // ↑ (-1) or ↓ (1).
    callback step(delta: int);
    callback target-clicked(index: int);
    callback tree-clicked(index: int);
    callback tree-toggled(index: int);
    callback filter-edited(text: string);
    // The path field's text changed by typing (not entered yet).
    callback path-edited(text: string);
    callback path-entered(text: string);
    callback new-folder();
    callback mode-chosen(is-move: bool);
    callback policy-chosen(policy: int);

    accessible-label: root.view.title;
    accessible-description: root.view.summary;

    init => {
        filter.text = root.view.filter;
        path.text = root.view.target-path;
        path.to-end();
        filter.take-focus();
    }

    // Back from the window over it (the name of a new folder): the filter has the keys again.
    changed active => {
        if (root.active) {
            filter.take-focus();
        }
    }

    // A new target shows its path in the field, over what was typed there, with its end (the
    // folder's name) in view.
    private property <string> target-path: root.view.target-path;
    changed target-path => {
        path.text = root.target-path;
        path.to-end();
    }

    // What was typed is no longer pending (another folder was chosen, or the path entered
    // turned out to be the target): the field shows the target.
    private property <bool> path-pending: root.view.path-edited;
    changed path-pending => {
        if (!root.path-pending) {
            path.text = root.view.target-path;
            path.to-end();
        }
    }

    changed scroll-serial => {
        tree.scroll-to(root.scroll-row);
    }

    // The keys the dialog takes wherever its focus is: the fields pass up those they do not
    // use, and the filter passes the arrows. The dialog itself never takes the focus (a click
    // between its parts leaves it where it was), so letters always go to a field.
    function key(event: KeyEvent) -> EventResult {
        if (event.text == Key.Escape) {
            root.cancelled();
            return EventResult.accept;
        }
        if (event.text == Key.UpArrow) {
            root.step(-1);
            return EventResult.accept;
        }
        if (event.text == Key.DownArrow) {
            root.step(1);
            return EventResult.accept;
        }
        if (event.text == Key.Return) {
            root.enter();
            return EventResult.accept;
        }
        return EventResult.reject;
    }

    // Scrolls the quick targets so that the one from `top` to `bottom` shows whole.
    function bring-into-view(top: length, bottom: length) {
        if (top < -quick.content-y) {
            quick.content-y = -top;
        } else if (bottom > -quick.content-y + quick.visible-height) {
            quick.content-y = quick.visible-height - bottom;
        }
    }

    keys := FocusScope {
        focus-on-click: false;
        focus-on-tab-navigation: false;
        key-pressed(event) => {
            return root.key(event);
        }

        VerticalLayout {
            padding-left: 24px;
            padding-right: 24px;
            padding-top: 20px;
            padding-bottom: 20px;
            spacing: 14px;

            // What goes where, the move/copy toggle and the close button.
            HorizontalLayout {
                spacing: 12px;

                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 8px;

                    Text {
                        text: root.view.title;
                        font-size: Theme.font-title;
                        font-weight: 700;
                        color: Theme.text;
                        overflow: elide;
                    }
                    HorizontalLayout {
                        spacing: 8px;

                        Text {
                            horizontal-stretch: 0;
                            text: root.view.summary;
                            color: Theme.muted;
                            vertical-alignment: center;
                        }
                        for chip in root.view.chips: Chip {
                            text: chip;
                        }
                        if root.view.more != "": Text {
                            horizontal-stretch: 0;
                            text: root.view.more;
                            font-size: Theme.font-small;
                            color: Theme.muted;
                            vertical-alignment: center;
                        }
                        Rectangle {
                            horizontal-stretch: 1;
                        }
                    }
                }
                VerticalLayout {
                    alignment: start;

                    SegmentTrack {
                        label: "작업";

                        Segment {
                            text: "이동";
                            chosen: root.view.is-move;
                            clicked => {
                                root.mode-chosen(true);
                                filter.take-focus();
                            }
                        }
                        Segment {
                            text: "복사";
                            chosen: !root.view.is-move;
                            clicked => {
                                root.mode-chosen(false);
                                filter.take-focus();
                            }
                        }
                    }
                }
                VerticalLayout {
                    alignment: start;

                    ToolButton {
                        icon: "close";
                        label: "닫기";
                        clicked => {
                            root.cancelled();
                        }
                    }
                }
            }

            // The target's path, and a new folder in it.
            HorizontalLayout {
                spacing: 10px;

                Text {
                    horizontal-stretch: 0;
                    height: 36px;
                    text: "대상 경로";
                    color: Theme.text;
                    font-weight: 500;
                    vertical-alignment: center;
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 4px;

                    path := Field {
                        icon: "folder";
                        label: "대상 경로";
                        hint: "폴더 경로를 입력하세요";
                        edited(text) => {
                            root.path-edited(text);
                        }
                        accepted(text) => {
                            root.path-entered(text);
                        }
                    }
                    if root.view.path-error != "": Text {
                        text: root.view.path-error;
                        font-size: Theme.font-small;
                        font-weight: 500;
                        color: Theme.text;
                    }
                }
                VerticalLayout {
                    alignment: start;

                    OutlineButton {
                        text: "새 폴더";
                        enabled: root.view.can-make-folder;
                        clicked => {
                            root.new-folder();
                        }
                    }
                }
            }

            // The folder tree with its filter, and the quick targets.
            HorizontalLayout {
                vertical-stretch: 1;
                spacing: 12px;

                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 8px;

                    filter := Field {
                        icon: "search";
                        label: "폴더 이름으로 거르기";
                        hint: "폴더 이름으로 거르기";
                        key(event) => {
                            if (event.text == Key.UpArrow || event.text == Key.DownArrow) {
                                return root.key(event);
                            }
                            return EventResult.reject;
                        }
                        edited(text) => {
                            root.filter-edited(text);
                        }
                        accepted => {
                            root.enter();
                        }
                    }
                    Rectangle {
                        vertical-stretch: 1;

                        tree := Sidebar {
                            label: "대상 폴더 트리";
                            rows: root.view.tree;
                            row-clicked(index) => {
                                root.tree-clicked(index);
                            }
                            row-toggled(index) => {
                                root.tree-toggled(index);
                            }
                        }
                        if root.view.tree-note != "": Text {
                            x: 16px;
                            y: 24px;
                            width: parent.width - 32px;
                            text: root.view.tree-note;
                            color: Theme.muted;
                            horizontal-alignment: center;
                            wrap: word-wrap;
                        }
                    }
                }
                Rectangle {
                    horizontal-stretch: 1;
                    border-width: 1px;
                    border-color: Theme.border;
                    border-radius: Theme.radius-large;
                    background: Theme.panel;
                    clip: true;
                    accessible-role: list;
                    accessible-label: "빠른 대상";

                    quick := ScrollView {
                        x: 1px;
                        y: 1px;
                        width: parent.width - 2px;
                        height: parent.height - 2px;

                        VerticalLayout {
                            alignment: start;
                            padding-top: 4px;
                            padding-bottom: 8px;

                            for target[i] in root.view.targets: TargetItem {
                                item: target;
                                index: i;
                                clicked => {
                                    root.target-clicked(i);
                                    filter.take-focus();
                                }
                                chosen(top, bottom) => {
                                    root.bring-into-view(top, bottom);
                                }
                            }
                        }
                    }
                }
            }

            Rectangle {
                height: 1px;
                background: Theme.border;
            }

            // What a name conflict does.
            HorizontalLayout {
                spacing: 12px;

                Text {
                    horizontal-stretch: 0;
                    height: 36px;
                    text: "이름이 겹치면";
                    color: Theme.text;
                    font-weight: 500;
                    vertical-alignment: center;
                }
                VerticalLayout {
                    alignment: center;

                    SegmentTrack {
                        label: "이름이 겹치면";

                        Segment {
                            text: "물어보기";
                            chosen: root.view.policy == 0;
                            clicked => {
                                root.policy-chosen(0);
                                filter.take-focus();
                            }
                        }
                        Segment {
                            text: "덮어쓰기";
                            chosen: root.view.policy == 1;
                            clicked => {
                                root.policy-chosen(1);
                                filter.take-focus();
                            }
                        }
                        Segment {
                            text: "건너뛰기";
                            chosen: root.view.policy == 2;
                            clicked => {
                                root.policy-chosen(2);
                                filter.take-focus();
                            }
                        }
                        Segment {
                            text: "이름 바꾸기";
                            chosen: root.view.policy == 3;
                            clicked => {
                                root.policy-chosen(3);
                                filter.take-focus();
                            }
                        }
                    }
                }
                HorizontalLayout {
                    horizontal-stretch: 1;
                    spacing: 6px;

                    if root.view.policy-danger: Icon {
                        y: (parent.height - self.height) / 2;
                        width: 18px;
                        height: 18px;
                        name: "warning";
                        color: Theme.warning;
                    }
                    Text {
                        horizontal-stretch: 1;
                        text: root.view.policy-note;
                        font-size: 13px;
                        color: root.view.policy-danger ? Theme.text : Theme.muted;
                        font-weight: root.view.policy-danger ? 600 : 400;
                        vertical-alignment: center;
                        wrap: word-wrap;
                    }
                }
            }

            // The room free at the target, what to beware of, and the buttons.
            HorizontalLayout {
                spacing: 12px;

                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    spacing: 2px;

                    if root.view.space != "": Text {
                        text: root.view.space;
                        font-size: Theme.font-small;
                        color: Theme.muted;
                    }
                    if root.view.problem != "": Text {
                        text: root.view.problem;
                        color: Theme.text;
                        font-weight: 500;
                        wrap: word-wrap;
                    }
                    if root.view.hint != "": Text {
                        text: root.view.hint;
                        font-size: 13px;
                        color: Theme.text;
                        wrap: word-wrap;
                    }
                }
                VerticalLayout {
                    alignment: center;

                    OutlineButton {
                        button-height: 40px;
                        text: "취소";
                        clicked => {
                            root.cancelled();
                        }
                    }
                }
                VerticalLayout {
                    alignment: center;

                    PrimaryButton {
                        button-height: 40px;
                        text: root.view.confirm-text;
                        enabled: root.view.can-confirm;
                        clicked => {
                            root.confirmed();
                        }
                    }
                }
            }
        }
    }
}
