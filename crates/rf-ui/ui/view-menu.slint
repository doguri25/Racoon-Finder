// The 보기 menu of the toolbar: how the active pane shows its folder (its view mode, order and
// columns, which its column heads change too), the theme, the hidden items and the extensions of
// the names, the sidebar and the preview panel, the layout and the commands between the panes,
// the tabs, 경로 복사 of the active pane's items, and 설정 (what a drop does, the thumbnails of
// the icon views, the undo of a dragged move, and on Windows the menu of a right click). It is short enough for a 560px window,
// with room to spare below its button: the themes, the panes (배치) and 설정 are sub-menus of
// their own, and 설정, at the bottom, has none of its own to open over it (정렬 ▸ 2차 정렬 and
// 열 ▸ 열 순서, higher up, do). Every item says its key (KEY-03), and the keys reach every item:
// F10 (macOS ⌘J) opens it, ↑↓ → Enter choose.
//
// A checkable item flips its own `checked` when it is chosen, which would end a binding, so the
// items are two-way bound to properties set from the state: the view's marks as the menu opens and
// after an item changed the view (`mark`), the theme's from `theme-choice`, and the layout's to the
// window's, which Rust sets back to the state's after the toggle.

import { Shortcuts, PathForms } from "shortcuts.slint";
import { PaneView } from "pane.slint";

export component ViewMenu inherits ContextMenuArea {
    // What the active pane shows.
    in property <PaneView> view;
    // The theme chosen (0 시스템 설정 따르기, 1 밝게, 2 어둡게).
    in property <int> theme-choice;
    // The layout, the hidden items and the extensions, two-way with the window's.
    in-out property <bool> show-hidden;
    in-out property <bool> show-extensions;
    in-out property <bool> show-tree;
    in-out property <bool> show-preview;
    in-out property <bool> dual-pane;
    in-out property <bool> stacked;
    in-out property <bool> sync-navigation;
    // 설정: what a drop does without a modifier key (0 이동, 1 복사, 2 OS 방식, 3 매번 묻기), and
    // the two switches, two-way with the window's; the last one only where it is offered
    // (Windows).
    in property <int> drag-default;
    in-out property <bool> move-undo-toast;
    in-out property <bool> system-menu-first;
    in property <bool> system-menu-offered;
    // What the bottom of 설정 offers for removing the app: 0 nothing, 1 "Racoon Finder 완전 삭제…"
    // (macOS), 2 "제거 프로그램 열기" (an installed app on Windows).
    in property <int> removal-offer;
    // The icon views show the files' thumbnails (VIEW-09), two-way with the window's.
    in-out property <bool> show-thumbnails;
    // A press held on a row opens its menu (PICK-02), two-way with the window's, and for how many
    // milliseconds (300, 500, 800 or 1200).
    in-out property <bool> long-press;
    in property <int> long-press-ms: 500;
    // The rows start with checkboxes (NAV-15), two-way with the window's: the same switch as the
    // 선택 menu's, which the keys cannot open.
    in-out property <bool> checkbox-select;

    // A command of the window's (`MainWindow.command`).
    callback command(name: string);
    callback theme-chosen(choice: int);
    // An item 끌어 놓기: … of 설정 chose `choice` (the numbers of `drag-default`).
    callback drag-default-chosen(choice: int);
    // An item 길게 누르기 시간: … of 설정 chose `ms` milliseconds.
    callback long-press-ms-chosen(ms: int);
    // 두 패널을 같은 크기로, and the divider moved by `step` of the room.
    callback even-split();
    callback divider-moved(step: float);
    // The active pane's order, columns and view, as the window's callbacks of the same names for
    // that pane.
    callback sort(column: int, then: bool);
    callback sort-then(column: int);
    callback column-toggled(column: int);
    // The column at `from` among those after the name goes to `slot` (as a head dragged).
    callback column-moved(from: int, slot: int);
    callback view-command(name: string);
    // An item of the 탭 sub-menu for the tab the active pane shows (`MainWindow.tab-command`).
    callback tab-command(name: string);
    // An item of a sub-menu was chosen: the keys are to go back where they were once the menus
    // have closed (a sub-menu's choice leaves them nowhere).
    callback sub-menu-done();

    // Opens the menu at `x`, `y`, its marks showing the active pane's view and what a drop
    // does.
    public function open(x: length, y: length) {
        root.mark();
        root.mark-drag-default(root.drag-default);
        root.mark-long-press-ms(root.long-press-ms);
        root.show({ x: x, y: y });
    }

    // The marks of the view's items, from the active pane's view.
    public function mark() {
        root.mark-mode-0 = root.view.mode == 0;
        root.mark-mode-1 = root.view.mode == 1;
        root.mark-mode-2 = root.view.mode == 2;
        root.mark-mode-3 = root.view.mode == 3;
        root.mark-mode-4 = root.view.mode == 4;
        root.mark-mode-5 = root.view.mode == 5;
        root.mark-folders-first = root.view.folders-first;
        root.mark-sort-0 = root.view.sort-key == 0;
        root.mark-sort-1 = root.view.sort-key == 1;
        root.mark-sort-2 = root.view.sort-key == 2;
        root.mark-sort-3 = root.view.sort-key == 3;
        root.mark-sort-4 = root.view.sort-key == 4;
        root.mark-sort-5 = root.view.sort-key == 5;
        root.mark-ascending = root.view.sort-ascending;
        root.mark-descending = !root.view.sort-ascending;
        root.mark-then-none = root.view.then-key < 0;
        root.mark-then-0 = root.view.then-key == 0;
        root.mark-then-1 = root.view.then-key == 1;
        root.mark-then-2 = root.view.then-key == 2;
        root.mark-then-3 = root.view.then-key == 3;
        root.mark-then-4 = root.view.then-key == 4;
        root.mark-then-5 = root.view.then-key == 5;
        root.mark-then-ascending = root.view.then-key >= 0 && root.view.then-ascending;
        root.mark-then-descending = root.view.then-key >= 0 && !root.view.then-ascending;
        root.mark-col-1 = root.view.shows[1];
        root.mark-col-2 = root.view.shows[2];
        root.mark-col-3 = root.view.shows[3];
        root.mark-col-4 = root.view.shows[4];
        root.mark-col-5 = root.view.shows[5];
        root.mark-col-6 = root.view.shows[6];
    }

    private property <bool> mark-mode-0;
    private property <bool> mark-mode-1;
    private property <bool> mark-mode-2;
    private property <bool> mark-mode-3;
    private property <bool> mark-mode-4;
    private property <bool> mark-mode-5;
    private property <bool> mark-folders-first;
    private property <bool> mark-sort-0;
    private property <bool> mark-sort-1;
    private property <bool> mark-sort-2;
    private property <bool> mark-sort-3;
    private property <bool> mark-sort-4;
    private property <bool> mark-sort-5;
    private property <bool> mark-ascending;
    private property <bool> mark-descending;
    private property <bool> mark-then-none;
    private property <bool> mark-then-0;
    private property <bool> mark-then-1;
    private property <bool> mark-then-2;
    private property <bool> mark-then-3;
    private property <bool> mark-then-4;
    private property <bool> mark-then-5;
    private property <bool> mark-then-ascending;
    private property <bool> mark-then-descending;
    private property <bool> mark-col-1;
    private property <bool> mark-col-2;
    private property <bool> mark-col-3;
    private property <bool> mark-col-4;
    private property <bool> mark-col-5;
    private property <bool> mark-col-6;

    private property <bool> system-mark: true;
    private property <bool> light-mark;
    private property <bool> dark-mark;
    function mark-theme(choice: int) {
        root.system-mark = choice == 0;
        root.light-mark = choice == 1;
        root.dark-mark = choice == 2;
    }
    init => {
        root.mark-theme(root.theme-choice);
    }
    changed theme-choice => {
        root.mark-theme(root.theme-choice);
    }

    private property <bool> drag-move-mark;
    private property <bool> drag-copy-mark;
    private property <bool> drag-system-mark;
    private property <bool> drag-ask-mark;
    function mark-drag-default(choice: int) {
        root.drag-move-mark = choice == 0;
        root.drag-copy-mark = choice == 1;
        root.drag-system-mark = choice == 2;
        root.drag-ask-mark = choice == 3;
    }
    // An item of what a drop does without a key (끌어 놓기: …): its mark alone shows, and Rust
    // keeps the choice.
    function choose-drag-default(choice: int) {
        root.mark-drag-default(choice);
        root.drag-default-chosen(choice);
        root.done();
    }

    private property <bool> press-300-mark;
    private property <bool> press-500-mark;
    private property <bool> press-800-mark;
    private property <bool> press-1200-mark;
    function mark-long-press-ms(ms: int) {
        root.press-300-mark = ms == 300;
        root.press-500-mark = ms == 500;
        root.press-800-mark = ms == 800;
        root.press-1200-mark = ms == 1200;
    }
    // An item of how long a press is held (길게 누르기 시간: …): its mark alone shows.
    function choose-long-press-ms(ms: int) {
        root.mark-long-press-ms(ms);
        root.long-press-ms-chosen(ms);
        root.done();
    }

    // An item of a sub-menu: its marks show the view it made.
    function done() {
        root.mark();
        root.sub-menu-done();
    }

    private property <bool> tab-pinned: root.view.tabs[root.view.active-tab].pinned;

    Menu {
        Menu {
            title: "보기 방식";

            // No key: File Explorer's Ctrl+Shift+1 is not assigned (keyboard.md). Ctrl+wheel
            // and a pinch step to it too.
            MenuItem {
                title: "특대 아이콘";
                checkable: true;
                checked <=> root.mark-mode-5;
                activated => {
                    root.command("view-extra-large-icons");
                    root.done();
                }
            }
            MenuItem {
                title: Shortcuts.titled("큰 아이콘", Shortcuts.view-large-icons);
                checkable: true;
                checked <=> root.mark-mode-4;
                activated => {
                    root.command("view-large-icons");
                    root.done();
                }
            }
            MenuItem {
                title: Shortcuts.titled("보통 아이콘", Shortcuts.view-medium-icons);
                checkable: true;
                checked <=> root.mark-mode-3;
                activated => {
                    root.command("view-medium-icons");
                    root.done();
                }
            }
            MenuItem {
                title: Shortcuts.titled("작은 아이콘", Shortcuts.view-small-icons);
                checkable: true;
                checked <=> root.mark-mode-2;
                activated => {
                    root.command("view-small-icons");
                    root.done();
                }
            }
            MenuItem {
                title: Shortcuts.titled("목록", Shortcuts.view-list);
                checkable: true;
                checked <=> root.mark-mode-1;
                activated => {
                    root.command("view-list");
                    root.done();
                }
            }
            MenuItem {
                title: Shortcuts.titled("자세히", Shortcuts.view-details);
                checkable: true;
                checked <=> root.mark-mode-0;
                activated => {
                    root.command("view-details");
                    root.done();
                }
            }
            MenuSeparator { }
            // The view of this folder for its subfolders too, or the folder's own view forgotten.
            MenuItem {
                title: "하위 폴더에 적용";
                activated => {
                    root.view-command("apply-below");
                    root.done();
                }
            }
            MenuItem {
                title: "기본값으로 되돌리기";
                enabled: root.view.own-view;
                activated => {
                    root.view-command("reset-view");
                    root.done();
                }
            }
        }
        // The order: the key and its direction (as a click on a head, which flips the direction
        // of the key that sorts already), the second key and its direction, folders first.
        Menu {
            title: "정렬";

            MenuItem {
                title: "이름";
                checkable: true;
                checked <=> root.mark-sort-0;
                activated => {
                    root.sort(0, false);
                    root.done();
                }
            }
            MenuItem {
                title: "크기";
                checkable: true;
                checked <=> root.mark-sort-1;
                activated => {
                    root.sort(1, false);
                    root.done();
                }
            }
            MenuItem {
                title: "수정한 날짜";
                checkable: true;
                checked <=> root.mark-sort-2;
                activated => {
                    root.sort(2, false);
                    root.done();
                }
            }
            MenuItem {
                title: "만든 날짜";
                checkable: true;
                checked <=> root.mark-sort-4;
                activated => {
                    root.sort(4, false);
                    root.done();
                }
            }
            MenuItem {
                title: "종류";
                checkable: true;
                checked <=> root.mark-sort-3;
                activated => {
                    root.sort(3, false);
                    root.done();
                }
            }
            MenuItem {
                title: "확장자";
                checkable: true;
                checked <=> root.mark-sort-5;
                activated => {
                    root.sort(5, false);
                    root.done();
                }
            }
            MenuSeparator { }
            MenuItem {
                title: "오름차순";
                checkable: true;
                checked <=> root.mark-ascending;
                activated => {
                    if (!root.view.sort-ascending) {
                        root.sort(root.view.sort-key, false);
                    }
                    root.done();
                }
            }
            MenuItem {
                title: "내림차순";
                checkable: true;
                checked <=> root.mark-descending;
                activated => {
                    if (root.view.sort-ascending) {
                        root.sort(root.view.sort-key, false);
                    }
                    root.done();
                }
            }
            MenuSeparator { }
            // The second key (Shift+click on a head), which breaks the ties of the first.
            Menu {
                title: "2차 정렬";

                MenuItem {
                    title: "없음";
                    checkable: true;
                    checked <=> root.mark-then-none;
                    activated => {
                        root.sort-then(-1);
                        root.done();
                    }
                }
                MenuItem {
                    title: "이름";
                    checkable: true;
                    checked <=> root.mark-then-0;
                    enabled: root.view.sort-key != 0;
                    activated => {
                        root.sort-then(0);
                        root.done();
                    }
                }
                MenuItem {
                    title: "크기";
                    checkable: true;
                    checked <=> root.mark-then-1;
                    enabled: root.view.sort-key != 1;
                    activated => {
                        root.sort-then(1);
                        root.done();
                    }
                }
                MenuItem {
                    title: "수정한 날짜";
                    checkable: true;
                    checked <=> root.mark-then-2;
                    enabled: root.view.sort-key != 2;
                    activated => {
                        root.sort-then(2);
                        root.done();
                    }
                }
                MenuItem {
                    title: "만든 날짜";
                    checkable: true;
                    checked <=> root.mark-then-4;
                    enabled: root.view.sort-key != 4;
                    activated => {
                        root.sort-then(4);
                        root.done();
                    }
                }
                MenuItem {
                    title: "종류";
                    checkable: true;
                    checked <=> root.mark-then-3;
                    enabled: root.view.sort-key != 3;
                    activated => {
                        root.sort-then(3);
                        root.done();
                    }
                }
                MenuItem {
                    title: "확장자";
                    checkable: true;
                    checked <=> root.mark-then-5;
                    enabled: root.view.sort-key != 5;
                    activated => {
                        root.sort-then(5);
                        root.done();
                    }
                }
                MenuSeparator { }
                MenuItem {
                    title: "오름차순";
                    checkable: true;
                    checked <=> root.mark-then-ascending;
                    enabled: root.view.then-key >= 0;
                    activated => {
                        if (!root.view.then-ascending) {
                            root.sort(root.view.then-key, true);
                        }
                        root.done();
                    }
                }
                MenuItem {
                    title: "내림차순";
                    checkable: true;
                    checked <=> root.mark-then-descending;
                    enabled: root.view.then-key >= 0;
                    activated => {
                        if (root.view.then-ascending) {
                            root.sort(root.view.then-key, true);
                        }
                        root.done();
                    }
                }
            }
            MenuItem {
                title: "폴더 먼저";
                checkable: true;
                checked <=> root.mark-folders-first;
                activated => {
                    root.view-command("folders-first");
                    root.done();
                }
            }
        }
        // The columns of 자세히 after the name (as the menu of its heads).
        Menu {
            title: "열";
            enabled: root.view.mode == 0;

            MenuItem {
                title: "크기";
                checkable: true;
                checked <=> root.mark-col-1;
                activated => {
                    root.column-toggled(1);
                    root.done();
                }
            }
            MenuItem {
                title: "수정한 날짜";
                checkable: true;
                checked <=> root.mark-col-2;
                activated => {
                    root.column-toggled(2);
                    root.done();
                }
            }
            MenuItem {
                title: "만든 날짜";
                checkable: true;
                checked <=> root.mark-col-4;
                activated => {
                    root.column-toggled(4);
                    root.done();
                }
            }
            MenuItem {
                title: "종류";
                checkable: true;
                checked <=> root.mark-col-3;
                activated => {
                    root.column-toggled(3);
                    root.done();
                }
            }
            MenuItem {
                title: "확장자";
                checkable: true;
                checked <=> root.mark-col-5;
                activated => {
                    root.column-toggled(5);
                    root.done();
                }
            }
            MenuItem {
                title: "속성";
                checkable: true;
                checked <=> root.mark-col-6;
                activated => {
                    root.column-toggled(6);
                    root.done();
                }
            }
            MenuSeparator { }
            // The order of the columns after the name: each moves a place left or right, as
            // its head dragged.
            Menu {
                title: "열 순서";
                enabled: root.view.columns.length > 1;

                for column[i] in root.view.columns: Menu {
                    title: column.title;

                    MenuItem {
                        title: "왼쪽으로";
                        enabled: i > 0;
                        activated => {
                            root.column-moved(i, i - 1);
                            root.done();
                        }
                    }
                    MenuItem {
                        title: "오른쪽으로";
                        enabled: i < root.view.columns.length - 1;
                        activated => {
                            root.column-moved(i, i + 2);
                            root.done();
                        }
                    }
                }
            }
            MenuItem {
                title: Shortcuts.titled("모든 열 너비 맞추기", Shortcuts.fit-columns);
                enabled: root.view.columns.length > 0;
                activated => {
                    root.command("fit-columns");
                    root.done();
                }
            }
        }
        MenuSeparator { }
        Menu {
            title: "테마";

            MenuItem {
                title: "밝게";
                checkable: true;
                checked <=> root.light-mark;
                activated => {
                    root.mark-theme(1);
                    root.theme-chosen(1);
                    root.done();
                }
            }
            MenuItem {
                title: "어둡게";
                checkable: true;
                checked <=> root.dark-mark;
                activated => {
                    root.mark-theme(2);
                    root.theme-chosen(2);
                    root.done();
                }
            }
            MenuItem {
                title: "시스템 설정 따르기";
                checkable: true;
                checked <=> root.system-mark;
                activated => {
                    root.mark-theme(0);
                    root.theme-chosen(0);
                    root.done();
                }
            }
        }
        MenuSeparator { }
        MenuItem {
            title: Shortcuts.titled("숨김 파일 보기", Shortcuts.toggle-hidden);
            checkable: true;
            checked <=> root.show-hidden;
            activated => {
                root.command("toggle-hidden");
            }
        }
        // File Explorer's 파일 확장명 (보기 ▸ 표시); no key there, nor in Finder.
        MenuItem {
            title: "파일 확장자 보기";
            checkable: true;
            checked <=> root.show-extensions;
            activated => {
                root.command("toggle-extensions");
            }
        }
        MenuItem {
            title: Shortcuts.titled("폴더 트리", Shortcuts.toggle-tree);
            checkable: true;
            checked <=> root.show-tree;
            activated => {
                root.command("toggle-tree");
            }
        }
        // Only to a tree that shows: F6 passes a hidden one by.
        MenuItem {
            title: Shortcuts.titled("폴더 트리로 가기", Shortcuts.focus-tree);
            enabled: root.show-tree;
            activated => {
                root.command("focus-tree");
            }
        }
        MenuItem {
            title: Shortcuts.titled("미리 보기 패널", Shortcuts.toggle-preview);
            checkable: true;
            checked <=> root.show-preview;
            activated => {
                root.command("toggle-preview");
            }
        }
        MenuSeparator { }
        // The panes: one or two, beside or above each other, the divider between them (its
        // items act only while two panes show), and the commands between them.
        Menu {
            title: "배치";

            MenuItem {
                title: Shortcuts.titled("듀얼 패널", Shortcuts.toggle-dual-pane);
                checkable: true;
                checked <=> root.dual-pane;
                activated => {
                    root.command("toggle-dual");
                    root.done();
                }
            }
            MenuItem {
                title: Shortcuts.titled("위아래로 나누기", Shortcuts.toggle-split);
                checkable: true;
                checked <=> root.stacked;
                activated => {
                    root.command("toggle-split");
                    root.done();
                }
            }
            MenuSeparator { }
            MenuItem {
                title: "두 패널을 같은 크기로";
                enabled: root.dual-pane;
                activated => {
                    root.even-split();
                    root.done();
                }
            }
            MenuItem {
                title: root.stacked ? "분할선을 위로" : "분할선을 왼쪽으로";
                enabled: root.dual-pane;
                activated => {
                    root.divider-moved(-0.1);
                    root.done();
                }
            }
            MenuItem {
                title: root.stacked ? "분할선을 아래로" : "분할선을 오른쪽으로";
                enabled: root.dual-pane;
                activated => {
                    root.divider-moved(0.1);
                    root.done();
                }
            }
            MenuSeparator { }
            // The commands between the two panes; those for the other pane act only while two
            // panes show.
            MenuItem {
                title: Shortcuts.titled("패널 바꾸기", Shortcuts.swap-panes);
                activated => {
                    root.command("swap-panes");
                    root.done();
                }
            }
            MenuItem {
                title: Shortcuts.titled("같은 폴더를 반대편에", Shortcuts.same-folder);
                enabled: root.dual-pane;
                activated => {
                    root.command("same-folder");
                    root.done();
                }
            }
            MenuItem {
                title: Shortcuts.titled("탐색 동기화", Shortcuts.sync-navigation);
                enabled: root.dual-pane;
                checkable: true;
                checked <=> root.sync-navigation;
                activated => {
                    root.command("toggle-sync");
                    root.done();
                }
            }
        }
        MenuSeparator { }
        // The tab the active pane shows (as its own menu, and the keys to move it along the
        // strip).
        Menu {
            title: "탭";

            MenuItem {
                title: "탭 복제";
                activated => {
                    root.tab-command("duplicate");
                    root.done();
                }
            }
            MenuItem {
                title: root.tab-pinned ? "탭 고정 풀기" : "탭 고정";
                activated => {
                    root.tab-command("pin");
                    root.done();
                }
            }
            MenuItem {
                title: "탭을 반대 패널로 옮기기";
                enabled: root.view.tabs.length > 1;
                activated => {
                    root.tab-command("move-other");
                    root.done();
                }
            }
            MenuItem {
                title: Shortcuts.titled("탭을 왼쪽으로", Shortcuts.move-tab-left);
                enabled: root.view.active-tab > 0;
                activated => {
                    root.tab-command("move-left");
                    root.done();
                }
            }
            MenuItem {
                title: Shortcuts.titled("탭을 오른쪽으로", Shortcuts.move-tab-right);
                enabled: root.view.active-tab < root.view.tabs.length - 1;
                activated => {
                    root.tab-command("move-right");
                    root.done();
                }
            }
            MenuSeparator { }
            MenuItem {
                title: Shortcuts.titled("닫은 탭 다시 열기", Shortcuts.reopen-tab);
                enabled: root.view.can-reopen;
                activated => {
                    root.tab-command("reopen");
                    root.done();
                }
            }
            MenuItem {
                title: "다른 탭 닫기";
                enabled: root.view.tabs[root.view.active-tab].can-close-others;
                activated => {
                    root.tab-command("close-others");
                    root.done();
                }
            }
            MenuItem {
                title: "오른쪽 탭 닫기";
                enabled: root.view.tabs[root.view.active-tab].can-close-right;
                activated => {
                    root.tab-command("close-right");
                    root.done();
                }
            }
        }
        // 경로 복사 of the active pane's items, as in an item's menu (the menu key, macOS ⌃↩):
        // the forms beside the key's reach the keyboard here too (KEY-02).
        Menu {
            title: "경로 복사";

            for form[i] in PathForms.titles: MenuItem {
                title: PathForms.title(i);
                activated => {
                    root.command("copy-path-\{i}");
                    root.done();
                }
            }
        }
        // The settings the app keeps that have no place elsewhere: what a drop does without a
        // modifier key (DND-02), the toast that offers to undo a dragged move (DND-07), and on
        // Windows whether a right click shows Windows' own menu (OPS-05). The four defaults are
        // its own items, not a sub-menu of it: a third level would open over the 보기 menu in a
        // narrow window and hide this one. After 경로 복사 without a separator, for the room of
        // a 560px window.
        Menu {
            title: "설정";

            MenuItem {
                title: "끌어 놓기: 이동";
                checkable: true;
                checked <=> root.drag-move-mark;
                activated => {
                    root.choose-drag-default(0);
                }
            }
            MenuItem {
                title: "끌어 놓기: 복사";
                checkable: true;
                checked <=> root.drag-copy-mark;
                activated => {
                    root.choose-drag-default(1);
                }
            }
            // As the system's file manager does: a move within a drive, a copy to another.
            MenuItem {
                title: "끌어 놓기: OS 방식";
                checkable: true;
                checked <=> root.drag-system-mark;
                activated => {
                    root.choose-drag-default(2);
                }
            }
            MenuItem {
                title: "끌어 놓기: 매번 묻기";
                checkable: true;
                checked <=> root.drag-ask-mark;
                activated => {
                    root.choose-drag-default(3);
                }
            }
            MenuSeparator { }
            MenuItem {
                title: "썸네일 보이기";
                checkable: true;
                checked <=> root.show-thumbnails;
                activated => {
                    root.command("toggle-thumbnails");
                    root.done();
                }
            }
            // The 선택 menu has this item too; here the keys reach it (F10, ↑↓, Enter; KEY-02).
            MenuItem {
                title: "체크박스로 선택";
                checkable: true;
                checked <=> root.checkbox-select;
                activated => {
                    root.command("toggle-checkboxes");
                    root.done();
                }
            }
            MenuSeparator { }
            MenuItem {
                title: "길게 눌러 메뉴 열기";
                checkable: true;
                checked <=> root.long-press;
                activated => {
                    root.command("toggle-long-press");
                    root.done();
                }
            }
            MenuItem {
                title: "길게 누르기 시간: 300 ms";
                checkable: true;
                checked <=> root.press-300-mark;
                enabled: root.long-press;
                activated => {
                    root.choose-long-press-ms(300);
                }
            }
            MenuItem {
                title: "길게 누르기 시간: 500 ms";
                checkable: true;
                checked <=> root.press-500-mark;
                enabled: root.long-press;
                activated => {
                    root.choose-long-press-ms(500);
                }
            }
            MenuItem {
                title: "길게 누르기 시간: 800 ms";
                checkable: true;
                checked <=> root.press-800-mark;
                enabled: root.long-press;
                activated => {
                    root.choose-long-press-ms(800);
                }
            }
            MenuItem {
                title: "길게 누르기 시간: 1200 ms";
                checkable: true;
                checked <=> root.press-1200-mark;
                enabled: root.long-press;
                activated => {
                    root.choose-long-press-ms(1200);
                }
            }
            MenuSeparator { }
            MenuItem {
                title: "끌어서 옮긴 뒤 되돌리기 알림";
                checkable: true;
                checked <=> root.move-undo-toast;
                activated => {
                    root.command("toggle-move-undo-toast");
                    root.done();
                }
            }
            if root.system-menu-offered: MenuItem {
                title: "오른쪽 클릭에 Windows 메뉴 바로 띄우기";
                checkable: true;
                checked <=> root.system-menu-first;
                activated => {
                    root.command("toggle-system-menu-first");
                    root.done();
                }
            }
            // The way out of the app, at the very bottom, where the system offers one.
            if root.removal-offer != 0: MenuSeparator { }
            if root.removal-offer == 1: MenuItem {
                title: "Racoon Finder 완전 삭제…";
                activated => {
                    root.command("remove-app");
                    root.done();
                }
            }
            if root.removal-offer == 2: MenuItem {
                title: "제거 프로그램 열기";
                activated => {
                    root.command("open-uninstaller");
                    root.done();
                }
            }
        }
    }
}
