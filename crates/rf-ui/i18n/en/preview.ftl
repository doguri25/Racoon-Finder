# The preview panel and Quick Look.

preview-unavailable = No preview available
preview-too-large = The file is too large to preview
# When the count of a folder's items goes past the most it counts.
preview-items-at-least = { $count } items or more
# After the encoding of a text, with " · ". $size: the size of the first part shown (256 KB).
preview-text-first = only the first { $size } shown
preview-online-only = Online-only files are not previewed
preview-no-room = The window is too narrow, so the preview panel is hidden. It comes back when the window is wider
