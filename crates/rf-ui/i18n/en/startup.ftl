# The start of the app: when it could not start, and when it was started a second time.

startup-failed = The app couldn't start
startup-no-window = Can't open a window. Check the display or graphics driver settings
# $reason: an error (error-*).
startup-no-app-folders = The folders for the settings and the job journal can't be used: { $reason }
startup-lock-failed = Can't lock the folder of the job journal: { $reason }
startup-already-running = The app is already running. Use the window that opened first.
