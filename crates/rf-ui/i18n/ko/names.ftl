# 이름: 새 폴더와 새 파일의 이름, 이름을 묻는 창, 확인 창이 늘어놓는 항목의 이름.

name-new-folder = 새 폴더
name-new-folder-title = 새 폴더
# 빈 텍스트 파일의 이름. 확장자 .txt를 그대로 둔다.
name-new-file = 새 텍스트 파일.txt
name-new-file-title = 새 파일
name-rename-title = 이름 바꾸기
# $char: 따옴표에 넣은 글자(‘:’)나 그 코드(U+0001).
name-has-character = 이름에 { $char } 문자를 쓸 수 없습니다
name-is-dots = ‘.’과 ‘..’은 이름으로 쓸 수 없습니다

## 확인 창의 이름들: 셋까지 따옴표에 넣어 ", "로 잇고, 남은 수를 뒤에 붙인다.

names-quoted = ‘{ $name }’
names-more = 외 { $count }개
